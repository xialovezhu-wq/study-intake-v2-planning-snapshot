{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/production-canary-terminal-receipt-v1.json",
  "title": "Production canary terminal receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "activation_id", "subject", "release_id",
    "producer_authority_fingerprint", "producer_high_watermark_sha256",
    "activation_receipt_sha256", "activation_gate_authority_sha256",
    "canary_gate_sha256", "canary_gate_authority_sha256", "selected",
    "outcome", "error_code", "completion_path", "completion_sha256",
    "completion_receipt_path", "completion_receipt_sha256", "package_path",
    "package_sha256", "observed_model_call_count",
    "observed_provider_request_count", "observed_mcp_tool_call_count",
    "read_session_id", "evidence_generation",
    "evidence_authority_fingerprint",
    "task_declared_evidence_refs_sha256", "mcp_stage_grounding",
    "finished_at", "state_after", "producer_capture_enabled",
    "sol_formal_curation_enabled", "post_activation_only",
    "per_subject_limit", "keep_backlog_drained", "production_accepted",
    "fast_mode_requested", "fast_mode_effective",
    "model_call_count", "provider_request_count", "formal_write_count",
    "sol_enabled", "authority"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-production-canary-terminal-receipt-v1"},
    "terminal_kind": {"enum": ["fail_closed_recovery", "post_terminal_projection_failure", "emergency_hard_cancel"]},
    "late_result_fenced": {"type": "boolean"},
    "prior_terminal_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "activation_id": {"$ref": "#/$defs/sha256"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "release_id": {"$ref": "#/$defs/sha256"},
    "producer_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "producer_high_watermark_sha256": {"$ref": "#/$defs/sha256"},
    "activation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "activation_gate_authority_sha256": {"$ref": "#/$defs/sha256"},
    "canary_gate_sha256": {"$ref": "#/$defs/sha256"},
    "canary_gate_authority_sha256": {"$ref": "#/$defs/sha256"},
    "selected": {"$ref": "#/$defs/selected"},
    "outcome": {"enum": ["succeeded", "failed", "timed_out", "cancelled", "waiting_retry", "needs_rework"]},
    "error_code": {"type": ["string", "null"]},
    "completion_path": {"anyOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "null"}]},
    "completion_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "completion_receipt_path": {"anyOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "null"}]},
    "completion_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "package_path": {"anyOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "null"}]},
    "package_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "observed_model_call_count": {"type": "integer", "minimum": 0},
    "observed_provider_request_count": {"type": "integer", "minimum": 0},
    "observed_mcp_tool_call_count": {"type": "integer", "minimum": 0},
    "read_session_id": {"type": ["string", "null"]},
    "evidence_generation": {"type": ["string", "null"]},
    "evidence_authority_fingerprint": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "task_declared_evidence_refs_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "mcp_stage_grounding": {"anyOf": [{"$ref": "#/$defs/stageGroundingPair"}, {"type": "null"}]},
    "finished_at": {"type": "string", "format": "date-time"},
    "state_after": {"enum": ["continuous_consumption_unlocked", "failed_drained"]},
    "producer_capture_enabled": {"const": true},
    "sol_formal_curation_enabled": {"const": false},
    "post_activation_only": {"const": true},
    "per_subject_limit": {"const": 1},
    "keep_backlog_drained": {"const": true},
    "production_accepted": {"const": false},
    "fast_mode_requested": {"const": true},
    "fast_mode_effective": {"enum": ["requested_unverified", "confirmed"]},
    "model_call_count": {"const": 0},
    "provider_request_count": {"const": 0},
    "formal_write_count": {"const": 0},
    "sol_enabled": {"const": false},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
    "stageGrounding": {
      "type": "object", "additionalProperties": false,
      "required": ["read_session_id", "read_session_manifest_sha256", "evidence_generation", "evidence_authority_fingerprint", "mcp_grounding_manifest_sha256", "consumed_evidence_refs", "cited_evidence_refs", "grounded_evidence_refs", "effective_allowed_evidence_refs_sha256", "mcp_tool_call_count"],
      "properties": {
        "read_session_id": {"type": "string", "minLength": 1},
        "read_session_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_generation": {"type": "string", "minLength": 1},
        "evidence_authority_fingerprint": {"$ref": "#/$defs/sha256"},
        "mcp_grounding_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "consumed_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cited_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "grounded_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effective_allowed_evidence_refs_sha256": {"$ref": "#/$defs/sha256"},
        "mcp_tool_call_count": {"type": "integer", "minimum": 1}
      }
    },
    "stageGroundingPair": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis", "critical_review"],
      "properties": {
        "analysis": {"$ref": "#/$defs/stageGrounding"},
        "critical_review": {"$ref": "#/$defs/stageGrounding"}
      }
    },
    "selected": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_unit_id", "producer_recorded_at", "producer_input_contract_sha256", "source_event_set_sha256", "unit_sha256", "frozen_payload_sha256"],
      "properties": {
        "producer_unit_id": {"type": "string", "minLength": 1},
        "producer_recorded_at": {"type": "string", "format": "date-time"},
        "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
        "unit_sha256": {"$ref": "#/$defs/sha256"},
        "frozen_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"},
        "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-production-canary-terminal"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
