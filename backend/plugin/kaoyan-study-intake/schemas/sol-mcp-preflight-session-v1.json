{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiazhibin.local/schemas/sol-mcp-preflight-session-v1.json",
  "title": "Sol MCP infrastructure preflight session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "preflight_session_id",
    "subject",
    "central_release_id",
    "mcp_release_id",
    "mcp_server_release",
    "mcp_release_manifest_sha256",
    "launcher_sha256",
    "tool_policy_sha256",
    "read_root",
    "read_root_identity_sha256",
    "created_at",
    "expires_at",
    "capture_id_absent",
    "production_task_id_absent",
    "candidate_eligible",
    "production_evidence",
    "formal_write_allowed",
    "formal_write_count",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "study-read-mcp-infrastructure-preflight-session.v1"},
    "purpose": {"const": "infrastructure_preflight"},
    "preflight_session_id": {"type": "string", "pattern": "^MCPPF-[A-Z0-9-]{16,80}$"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "central_release_id": {"$ref": "#/$defs/sha"},
    "mcp_release_id": {"$ref": "#/$defs/sha"},
    "mcp_server_release": {"type": "string", "minLength": 1, "maxLength": 200},
    "mcp_release_manifest_sha256": {"$ref": "#/$defs/sha"},
    "launcher_sha256": {"$ref": "#/$defs/sha"},
    "tool_policy_sha256": {"$ref": "#/$defs/sha"},
    "read_root": {"type": "string", "minLength": 1},
    "read_root_identity_sha256": {"$ref": "#/$defs/sha"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "capture_id_absent": {"const": true},
    "production_task_id_absent": {"const": true},
    "candidate_eligible": {"const": false},
    "production_evidence": {"const": false},
    "formal_write_allowed": {"const": false},
    "formal_write_count": {"const": 0},
    "manifest_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
