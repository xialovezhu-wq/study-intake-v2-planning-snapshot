{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic Golden assertion result for a live mathematics Luna task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "capture_id", "business_task_id", "formal_id", "task_kind", "package_sha256", "report_sha256", "operation_types", "assertions", "semantic_assertion_status", "model_call_count", "formal_write_count"],
  "properties": {
    "schema_version": {"const": "study-intake-math-live-business-golden-assertion-result-v1"},
    "status": {"const": "passed"},
    "capture_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "business_task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "formal_id": {"enum": ["GS-109", "GS-507", null]},
    "task_kind": {"enum": ["independent_correct_no_false_wrong_card", "wrong_then_corrected_weakness_proposal", "wrong_then_corrected_multistage_method_proposal"]},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["mark_existing_item", "propose_item_update", "propose_new_item", "mark_existing_knowledge", "propose_new_knowledge", "propose_relation", "mark_status", "needs_review"]}
    },
    "assertions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "semantic_assertion_status": {"const": "passed"},
    "model_call_count": {"const": 2},
    "formal_write_count": {"const": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"formal_id": {"const": "GS-109"}}, "required": ["formal_id"]},
      "then": {
        "properties": {
          "task_kind": {"const": "independent_correct_no_false_wrong_card"},
          "operation_types": {"items": {"enum": ["mark_existing_item", "mark_existing_knowledge", "mark_status"]}}
        }
      }
    },
    {
      "if": {"properties": {"formal_id": {"const": "GS-507"}}, "required": ["formal_id"]},
      "then": {
        "properties": {
          "task_kind": {"const": "wrong_then_corrected_weakness_proposal"},
          "operation_types": {"contains": {"const": "propose_item_update"}}
        }
      }
    },
    {
      "if": {"properties": {"formal_id": {"type": "null"}}, "required": ["formal_id"]},
      "then": {
        "properties": {
          "task_kind": {"const": "wrong_then_corrected_multistage_method_proposal"},
          "operation_types": {
            "items": {"enum": ["propose_new_item", "mark_existing_knowledge", "propose_new_knowledge", "propose_relation", "mark_status", "needs_review"]},
            "contains": {"const": "propose_new_item"}
          }
        }
      }
    }
  ]
}
