{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-production-canary-gate-receipt-v2",
  "type": "object",
  "required": [
    "activation_gate_authority_sha256", "activation_id", "activation_receipt_sha256",
    "admitted_at", "authority", "continuous_concurrency_limit",
    "fast_mode_effective", "fast_mode_requested", "formal_write_count",
    "initial_canary_inflight_limit", "keep_backlog_drained", "mcp_tool_call_count",
    "model_call_count", "post_activation_only", "producer_authority_fingerprint",
    "producer_capture_enabled", "producer_high_watermark_sha256", "production_accepted",
    "provider_request_count", "release_id", "requested_service_tier", "schema_version",
    "selected", "sol_enabled", "sol_formal_curation_enabled", "state_after",
    "state_before", "subject"
  ],
  "properties": {
    "activation_gate_authority_sha256": {"$ref": "#/$defs/sha256"},
    "activation_id": {"$ref": "#/$defs/sha256"},
    "activation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "admitted_at": {"$ref": "#/$defs/timestamp"},
    "authority": {"$ref": "#/$defs/authority"},
    "continuous_concurrency_limit": {"type": "integer", "minimum": 1, "maximum": 64},
    "fast_mode_effective": {"const": "not_requested"},
    "fast_mode_requested": {"const": false},
    "formal_write_count": {"const": 0},
    "initial_canary_inflight_limit": {"const": 1},
    "keep_backlog_drained": {"const": true},
    "mcp_tool_call_count": {"const": 0},
    "model_call_count": {"const": 0},
    "post_activation_only": {"const": true},
    "producer_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "producer_capture_enabled": {"const": true},
    "producer_high_watermark_sha256": {"$ref": "#/$defs/sha256"},
    "production_accepted": {"const": false},
    "provider_request_count": {"const": 0},
    "release_id": {"$ref": "#/$defs/sha256"},
    "requested_service_tier": {"type": "null"},
    "schema_version": {"const": "study-intake-production-canary-gate-receipt-v2"},
    "selected": {"$ref": "#/$defs/gate_selection"},
    "sol_enabled": {"const": false},
    "sol_formal_curation_enabled": {"const": false},
    "state_after": {"enum": ["canary_in_flight", "continuous_concurrent_unlocked"]},
    "state_before": {"enum": ["armed", "continuous_concurrent_unlocked"]},
    "subject": {"$ref": "#/$defs/subject"}
  },
  "allOf": [
    {
      "if": {"properties": {"state_before": {"const": "armed"}}, "required": ["state_before"]},
      "then": {"properties": {"state_after": {"const": "canary_in_flight"}}},
      "else": {"properties": {"state_after": {"const": "continuous_concurrent_unlocked"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "absolute_path": {"type": "string", "pattern": "^/", "minLength": 2},
    "subject": {"enum": ["math", "cs408", "english"]},
    "authority": {
      "type": "object",
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"},
        "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-production-canary-gate"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "gate_selection": {
      "type": "object",
      "required": [
        "producer_unit_id", "producer_recorded_at", "producer_input_contract_sha256",
        "source_event_set_sha256", "unit_sha256", "frozen_payload_sha256",
        "lease_owner_id", "lease_fence", "context_root", "mcp_session_root",
        "report_root", "process_identity_sha256", "process_identity_path"
      ],
      "properties": {
        "producer_unit_id": {"type": "string", "minLength": 1},
        "producer_recorded_at": {"$ref": "#/$defs/timestamp"},
        "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
        "unit_sha256": {"$ref": "#/$defs/sha256"},
        "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
        "lease_owner_id": {"type": "string", "minLength": 1},
        "lease_fence": {"type": "integer", "minimum": 1},
        "context_root": {"$ref": "#/$defs/absolute_path"},
        "mcp_session_root": {"$ref": "#/$defs/absolute_path"},
        "report_root": {"$ref": "#/$defs/absolute_path"},
        "process_identity_sha256": {"type": "null"},
        "process_identity_path": {"type": "null"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
