{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/production-canary-state-v1.json",
  "title": "Subject production canary state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "state", "subject", "release_id",
    "activation_id", "activated_at", "producer_authority_fingerprint",
    "producer_high_watermark", "producer_high_watermark_sha256",
    "activation_receipt_sha256", "activation_receipt_path",
    "activation_gate_authority_sha256", "producer_capture_enabled",
    "luna_consumer_enabled", "sol_formal_curation_enabled", "queue_depth",
    "historical_eligible_count", "excluded_by_high_watermark_count",
    "canary_queue_count", "queue_classification",
    "oldest_pending_age_seconds", "active_task_count", "last_success_at",
    "last_failure_at", "last_preclaim_failure_at",
    "last_preclaim_failure_stage", "last_preclaim_failure_error_code",
    "last_preclaim_failure_receipt_sha256",
    "last_preclaim_failure_evidence_sha256",
    "preclaim_failure_resume_ack_sha256", "last_emergency_cancel_at",
    "last_emergency_cancel_receipt_sha256", "late_result_fence_status",
    "observability_counter_scope",
    "observed_model_call_count", "observed_provider_request_count",
    "observed_mcp_tool_call_count", "last_analysis_status",
    "last_critical_review_status", "last_report_status",
    "last_package_sha256", "last_read_session_id",
    "last_evidence_generation", "last_evidence_authority_fingerprint",
    "last_analysis_grounding_manifest_sha256",
    "last_critical_review_grounding_manifest_sha256",
    "last_analysis_evidence_refs", "last_critical_review_evidence_refs",
    "blocking_reason", "next_action", "selected",
    "last_selected", "unlocked_once", "post_activation_only",
    "per_subject_limit", "keep_backlog_drained", "production_accepted",
    "fast_mode_requested", "fast_mode_effective",
    "model_call_count", "provider_request_count", "formal_write_count",
    "sol_enabled", "updated_at", "authority"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-production-canary-state-v1"},
    "status": {"enum": ["production_canary_active", "production_canary_inactive"]},
    "state": {"enum": ["armed", "canary_in_flight", "continuous_consumption_unlocked", "failed_drained", "paused_drained", "inactive_rolled_back"]},
    "subject": {"enum": ["math", "cs408", "english"]},
    "release_id": {"$ref": "#/$defs/sha256"},
    "activation_id": {"$ref": "#/$defs/sha256"},
    "activated_at": {"type": "string", "format": "date-time"},
    "producer_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "producer_high_watermark": {"$ref": "#/$defs/highWatermark"},
    "producer_high_watermark_sha256": {"$ref": "#/$defs/sha256"},
    "activation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "activation_receipt_path": {"$ref": "#/$defs/absolutePath"},
    "activation_gate_authority_sha256": {"$ref": "#/$defs/sha256"},
    "producer_capture_enabled": {"const": true},
    "luna_consumer_enabled": {"type": "boolean"},
    "sol_formal_curation_enabled": {"const": false},
    "queue_depth": {"type": "integer", "minimum": 0},
    "historical_eligible_count": {"type": "integer", "minimum": 0},
    "excluded_by_high_watermark_count": {"type": "integer", "minimum": 0},
    "canary_queue_count": {"type": "integer", "minimum": 0},
    "queue_classification": {"$ref": "#/$defs/queueClassification"},
    "oldest_pending_age_seconds": {"type": ["integer", "null"], "minimum": 0},
    "active_task_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "last_success_at": {"type": ["string", "null"], "format": "date-time"},
    "last_failure_at": {"type": ["string", "null"], "format": "date-time"},
    "last_preclaim_failure_at": {"type": ["string", "null"], "format": "date-time"},
    "last_preclaim_failure_stage": {"enum": ["producer_contract", "materialize", "consumer_admission", "pre_claim", "submit_generation_fence", null]},
    "last_preclaim_failure_error_code": {"type": ["string", "null"]},
    "last_preclaim_failure_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "last_preclaim_failure_evidence_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "preclaim_failure_resume_ack_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "last_emergency_cancel_at": {"type": ["string", "null"], "format": "date-time"},
    "last_emergency_cancel_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "late_result_fence_status": {"enum": ["not_required", "sealed"]},
    "observability_counter_scope": {"const": "current_activation_cumulative"},
    "observed_model_call_count": {"type": "integer", "minimum": 0},
    "observed_provider_request_count": {"type": "integer", "minimum": 0},
    "observed_mcp_tool_call_count": {"type": "integer", "minimum": 0},
    "last_analysis_status": {"enum": ["not_started", "completed", "failed_or_incomplete"]},
    "last_critical_review_status": {"enum": ["not_started", "completed", "failed_or_incomplete"]},
    "last_report_status": {"enum": ["not_started", "reopen_verified", "not_verified"]},
    "last_package_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "last_read_session_id": {"type": ["string", "null"]},
    "last_evidence_generation": {"type": ["string", "null"]},
    "last_evidence_authority_fingerprint": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "last_analysis_grounding_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "last_critical_review_grounding_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "last_analysis_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "last_critical_review_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blocking_reason": {"type": ["string", "null"]},
    "next_action": {"type": "string", "minLength": 1},
    "selected": {"anyOf": [{"$ref": "#/$defs/selected"}, {"type": "null"}]},
    "last_selected": {"anyOf": [{"$ref": "#/$defs/selected"}, {"type": "null"}]},
    "unlocked_once": {"type": "boolean"},
    "last_terminal_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "last_terminal_receipt_path": {"$ref": "#/$defs/absolutePath"},
    "post_activation_only": {"const": true},
    "per_subject_limit": {"const": 1},
    "keep_backlog_drained": {"const": true},
    "production_accepted": {"const": false},
    "fast_mode_requested": {"const": true},
    "fast_mode_effective": {"enum": ["requested_unverified", "confirmed"]},
    "model_call_count": {"const": 0},
    "provider_request_count": {"const": 0},
    "formal_write_count": {"const": 0},
    "sol_enabled": {"const": false},
    "updated_at": {"type": "string", "format": "date-time"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "inactive_rolled_back"}}},
      "then": {"properties": {"status": {"const": "production_canary_inactive"}, "luna_consumer_enabled": {"const": false}}},
      "else": {"properties": {"status": {"const": "production_canary_active"}}}
    },
    {
      "if": {"properties": {"state": {"enum": ["paused_drained", "failed_drained"]}}},
      "then": {"properties": {"luna_consumer_enabled": {"const": false}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
    "selected": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_unit_id", "producer_recorded_at", "producer_input_contract_sha256", "source_event_set_sha256", "unit_sha256", "frozen_payload_sha256", "canary_gate_sha256", "canary_gate_path", "canary_gate_authority_sha256"],
      "properties": {
        "producer_unit_id": {"type": "string", "minLength": 1},
        "producer_recorded_at": {"type": "string", "format": "date-time"},
        "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
        "unit_sha256": {"$ref": "#/$defs/sha256"},
        "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
        "canary_gate_sha256": {"$ref": "#/$defs/sha256"},
        "canary_gate_path": {"$ref": "#/$defs/absolutePath"},
        "canary_gate_authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "queueClassification": {
      "type": "object", "additionalProperties": false,
      "required": ["pre_activation_frozen", "pending", "claimed", "succeeded", "failed"],
      "properties": {
        "pre_activation_frozen": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "claimed": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "highWatermark": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "subject", "release_id", "recorded_at", "producer_authority_fingerprint", "source_event_ids", "source_event_set_sha256", "formal_write_count"],
      "properties": {
        "schema_version": {"const": "study-intake-producer-high-watermark-v1"},
        "subject": {"enum": ["math", "cs408", "english"]},
        "release_id": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "producer_authority_fingerprint": {"$ref": "#/$defs/sha256"},
        "source_event_ids": {"type": "array", "maxItems": 0},
        "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
        "formal_write_count": {"const": 0}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"},
        "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-production-canary-state"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
