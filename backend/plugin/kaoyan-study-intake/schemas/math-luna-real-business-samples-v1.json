{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authoritative mathematics Luna real-business sample set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authoritative_entrypoint",
    "created_at",
    "root",
    "state",
    "directory_mode",
    "task_count",
    "supersedes",
    "source_boundary",
    "runtime_contract",
    "runtime_authority",
    "model_request",
    "tasks",
    "storage_routing"
  ],
  "properties": {
    "schema_version": {"const": "math-luna-real-business-samples-v1"},
    "authoritative_entrypoint": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "root": {"type": "string", "pattern": "^/"},
    "state": {"const": "ready_for_real_luna_business_testing"},
    "directory_mode": {"const": "operational_writable_for_test_state_and_outputs"},
    "task_count": {"type": "integer", "minimum": 1},
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "source_boundary": {"$ref": "#/$defs/path_hash"},
    "runtime_contract": {"$ref": "#/$defs/path_hash"},
    "runtime_authority": {"$ref": "#/$defs/runtime_authority"},
    "model_request": {"$ref": "#/$defs/model_request"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/task"}
    },
    "storage_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_root_frozen", "new_study_questions_use_separate_root", "future_capture_root", "reason"],
      "properties": {
        "sample_root_frozen": {"const": false},
        "new_study_questions_use_separate_root": {"const": true},
        "future_capture_root": {"type": "string", "pattern": "^/"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  },
  "$defs": {
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "model_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "runtime_attestation"],
      "properties": {
        "model": {"const": "gpt-5.6-luna"},
        "reasoning_effort": {"const": "max"},
        "runtime_attestation": {"const": "requested_unverified"}
      }
    },
    "runtime_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["luna", "sol", "quick_intake"],
      "properties": {
        "luna": {
          "type": "object",
          "additionalProperties": false,
          "required": ["processing_authorized", "local_database_read_authorized", "output_role", "formal_library_write_authorized"],
          "properties": {
            "processing_authorized": {"const": true},
            "local_database_read_authorized": {"const": true},
            "output_role": {"const": "preprocessing_proposal"},
            "formal_library_write_authorized": {"const": false}
          }
        },
        "sol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formal_library_writer", "execution_authorization"],
          "properties": {
            "formal_library_writer": {"const": true},
            "execution_authorization": {"const": "governed_by_downstream_formal_workflow"}
          }
        },
        "quick_intake": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorization"],
          "properties": {
            "authorization": {"const": "governed_by_live_intake_system"}
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_task_id",
        "capture_id",
        "source_route",
        "formal_id",
        "absolute_path",
        "manifest_path",
        "manifest_sha256",
        "content_fingerprint",
        "task_kind",
        "blocking_missing_artifacts"
      ],
      "properties": {
        "business_task_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "capture_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_route": {"enum": ["existing_formal_card_review", "new_source_learning_episode"]},
        "formal_id": {
          "oneOf": [
            {"type": "string", "pattern": "^GS-[0-9]+$"},
            {"type": "null"}
          ]
        },
        "source_locator": {"type": "string", "minLength": 1, "maxLength": 320},
        "absolute_path": {"type": "string", "pattern": "^/"},
        "manifest_path": {"type": "string", "pattern": "^/"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "task_kind": {
          "enum": [
            "independent_correct_no_false_wrong_card",
            "wrong_then_corrected_weakness_proposal",
            "wrong_then_corrected_multistage_method_proposal"
          ]
        },
        "blocking_missing_artifacts": {"type": "array", "maxItems": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"source_route": {"const": "existing_formal_card_review"}}, "required": ["source_route"]},
          "then": {"properties": {"formal_id": {"type": "string"}}}
        },
        {
          "if": {"properties": {"source_route": {"const": "new_source_learning_episode"}}, "required": ["source_route"]},
          "then": {"properties": {"formal_id": {"type": "null"}}, "required": ["source_locator"]}
        }
      ]
    }
  }
}
