{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-dispatch-report-v2",
  "type": "object",
  "required": [
    "analysis",
    "capture_id",
    "critical_review",
    "formal_write_count",
    "package_ref",
    "package_sha256",
    "release_id",
    "schema_version",
    "subject",
    "unit_sha256"
  ],
  "properties": {
    "analysis": {"$ref": "#/$defs/nonempty_json_object"},
    "capture_id": {"type": "string", "minLength": 1},
    "critical_review": {"$ref": "#/$defs/nonempty_json_object"},
    "formal_write_count": {"const": 0},
    "package_ref": {
      "type": "string",
      "pattern": "^study-intake-dispatch-package://sha256/[0-9a-f]{64}$"
    },
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "release_id": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": "study-intake-dispatch-report-v2"},
    "subject": {"$ref": "#/$defs/subject"},
    "unit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "json_scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "json_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/json_value"}
    },
    "json_object": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/json_value"}
    },
    "nonempty_json_object": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/json_value"}
    },
    "json_value": {
      "oneOf": [
        {"$ref": "#/$defs/json_scalar"},
        {"$ref": "#/$defs/json_array"},
        {"$ref": "#/$defs/json_object"}
      ]
    }
  },
  "additionalProperties": false
}
