{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/producer-dispatch-input-v2.json",
  "title": "Producer to dispatcher input contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "subject", "release_id", "authority_fingerprint",
    "producer_unit_id", "producer_recorded_at", "input_fingerprint",
    "source_events", "earliest_source_recorded_at",
    "latest_source_recorded_at", "source_event_set_sha256",
    "capture_type", "evidence_contract", "evidence_contract_sha256",
    "formal_write_count", "producer_input_contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-producer-dispatch-input-v2"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "release_id": {"$ref": "#/$defs/sha256"},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "producer_unit_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "producer_recorded_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_events": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/sourceEvent"}
    },
    "earliest_source_recorded_at": {"type": "string", "format": "date-time"},
    "latest_source_recorded_at": {"type": "string", "format": "date-time"},
    "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
    "capture_type": {
      "oneOf": [
        {"enum": ["formal_problem", "new_source_problem", "existing_formal_card_observation", "fact_observation"]},
        {"type": "null"}
      ]
    },
    "evidence_contract": {
      "oneOf": [{"$ref": "#/$defs/mathEvidenceContract"}, {"type": "null"}]
    },
    "evidence_contract_sha256": {"$ref": "#/$defs/nullableSha256"},
    "formal_write_count": {"const": 0},
    "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"subject": {"const": "math"}}, "required": ["subject"]},
      "then": {
        "properties": {
          "capture_type": {"enum": ["formal_problem", "new_source_problem", "existing_formal_card_observation", "fact_observation"]},
          "evidence_contract": {"$ref": "#/$defs/mathEvidenceContract"},
          "evidence_contract_sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {
          "capture_type": {"type": "null"},
          "evidence_contract": {"type": "null"},
          "evidence_contract_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "sourceEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "recorded_at", "source_sha256"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "recorded_at": {"type": "string", "format": "date-time"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mathEvidenceContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "capture_type", "stable_formal_id",
        "source_fingerprint", "content_fingerprint",
        "verbatim_learning_record_sha256", "full_dialogue_sha256",
        "question_image_sha256s", "solution_image_sha256s",
        "canonical_solution_text_sha256", "evidence_status", "missing_roles",
        "formal_write_count"
      ],
      "properties": {
        "schema_version": {"const": "study-intake-math-capture-evidence-contract-v1"},
        "capture_type": {"enum": ["formal_problem", "new_source_problem", "existing_formal_card_observation", "fact_observation"]},
        "stable_formal_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]},
        "source_fingerprint": {"$ref": "#/$defs/nullableSha256"},
        "content_fingerprint": {"$ref": "#/$defs/nullableSha256"},
        "verbatim_learning_record_sha256": {"$ref": "#/$defs/sha256"},
        "full_dialogue_sha256": {"$ref": "#/$defs/nullableSha256"},
        "question_image_sha256s": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "solution_image_sha256s": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "canonical_solution_text_sha256": {"$ref": "#/$defs/nullableSha256"},
        "evidence_status": {"const": "ready"},
        "missing_roles": {"type": "array", "maxItems": 0},
        "formal_write_count": {"const": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"capture_type": {"enum": ["formal_problem", "new_source_problem"]}}, "required": ["capture_type"]},
          "then": {
            "properties": {"question_image_sha256s": {"minItems": 1}},
            "anyOf": [
              {"properties": {"solution_image_sha256s": {"minItems": 1}}},
              {"properties": {"canonical_solution_text_sha256": {"$ref": "#/$defs/sha256"}}}
            ]
          }
        },
        {
          "if": {"properties": {"capture_type": {"const": "existing_formal_card_observation"}}, "required": ["capture_type"]},
          "then": {
            "properties": {
              "stable_formal_id": {"type": "string", "minLength": 1, "maxLength": 512},
              "full_dialogue_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {"properties": {"capture_type": {"const": "fact_observation"}}, "required": ["capture_type"]},
          "then": {
            "properties": {"full_dialogue_sha256": {"$ref": "#/$defs/sha256"}},
            "anyOf": [
              {"properties": {"source_fingerprint": {"$ref": "#/$defs/sha256"}}},
              {"properties": {"content_fingerprint": {"$ref": "#/$defs/sha256"}}}
            ]
          }
        }
      ]
    }
  }
}
