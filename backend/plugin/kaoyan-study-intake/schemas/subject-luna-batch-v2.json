{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/subject-luna-batch-v2.json",
  "title": "Subject Luna Batch v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "subject", "study_date", "status",
    "capture_high_watermark", "scan_snapshot_sha256", "authority_generation",
    "authority_fingerprint", "tasks", "exclusion_receipt_sha256s",
    "all_terminal", "sol_ready", "blocking_task_ids",
    "sol_candidate_task_ids", "diagnostic_task_ids", "formal_write_count",
    "revision", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "subject_luna_batch_v2"},
    "batch_id": {"$ref": "#/$defs/nonempty"},
    "subject": {"$ref": "#/$defs/subject"},
    "study_date": {"$ref": "#/$defs/nonempty"},
    "status": {"enum": ["open", "frozen"]},
    "capture_high_watermark": {"$ref": "#/$defs/nonempty"},
    "scan_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "authority_generation": {"$ref": "#/$defs/nonempty"},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    },
    "exclusion_receipt_sha256s": {"$ref": "#/$defs/uniqueHashArray"},
    "all_terminal": {"type": "boolean"},
    "sol_ready": {"type": "boolean"},
    "blocking_task_ids": {"$ref": "#/$defs/uniqueIdArray"},
    "sol_candidate_task_ids": {"$ref": "#/$defs/uniqueIdArray"},
    "diagnostic_task_ids": {"$ref": "#/$defs/uniqueIdArray"},
    "formal_write_count": {"const": 0},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nonempty": {"type": "string", "minLength": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "uniqueHashArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "uniqueIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id", "unit_sha256", "input_fingerprint", "study_date",
        "frozen_payload_sha256", "status",
        "analysis_execution_receipt_sha256", "analysis_raw_output_sha256",
        "analysis_normalization_receipt_sha256", "analysis_report_sha256",
        "critical_review_execution_receipt_sha256",
        "critical_review_raw_output_sha256",
        "critical_review_normalization_receipt_sha256",
        "critical_review_report_sha256", "package_sha256",
        "sol_handoff_envelope_sha256", "warning_codes",
        "terminal_receipt_sha256", "error_code"
      ],
      "properties": {
        "capture_id": {"$ref": "#/$defs/nonempty"},
        "unit_sha256": {"$ref": "#/$defs/sha256"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "study_date": {"$ref": "#/$defs/nonempty"},
        "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
        "status": {
          "enum": [
            "selected", "claimed", "analysis_running",
            "critical_review_running", "packaging", "workflow_complete",
            "workflow_complete_with_warnings", "workflow_partial",
            "execution_failed", "cancelled", "stalled"
          ]
        },
        "analysis_execution_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "analysis_raw_output_sha256": {"$ref": "#/$defs/nullableSha256"},
        "analysis_normalization_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "analysis_report_sha256": {"$ref": "#/$defs/nullableSha256"},
        "critical_review_execution_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "critical_review_raw_output_sha256": {"$ref": "#/$defs/nullableSha256"},
        "critical_review_normalization_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "critical_review_report_sha256": {"$ref": "#/$defs/nullableSha256"},
        "package_sha256": {"$ref": "#/$defs/nullableSha256"},
        "sol_handoff_envelope_sha256": {"$ref": "#/$defs/nullableSha256"},
        "warning_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "terminal_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "error_code": {"oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]}
      }
    }
  }
}
