{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/production-canary-queue-entry-v1.json",
  "title": "Persistent producer canary queue entry v1",
  "type": "object",
  "required": [
    "schema_version", "activation_id", "subject", "release_id",
    "producer_high_watermark_sha256", "producer_authority_fingerprint",
    "producer_input_contract_sha256", "producer_unit_id",
    "producer_recorded_at", "source_event_set_sha256", "source_event_ids",
    "unit_sha256", "frozen_payload_sha256", "task_object_sha256",
    "task_object_path", "queue_status", "discovered_at", "claimed_at",
    "finished_at", "canary_gate_sha256", "terminal_receipt_sha256",
    "formal_write_count", "authority"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-production-canary-queue-entry-v1"},
    "activation_id": {"$ref": "#/$defs/sha256"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "release_id": {"$ref": "#/$defs/sha256"},
    "producer_high_watermark_sha256": {"$ref": "#/$defs/sha256"},
    "producer_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"},
    "producer_unit_id": {"type": "string", "minLength": 1},
    "producer_recorded_at": {"type": "string", "format": "date-time"},
    "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unit_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
    "task_object_sha256": {"$ref": "#/$defs/sha256"},
    "task_object_path": {"$ref": "#/$defs/absolutePath"},
    "queue_status": {"enum": ["pending", "claimed", "succeeded", "failed"]},
    "discovered_at": {"type": "string", "format": "date-time"},
    "claimed_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "canary_gate_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "canary_gate_path": {"anyOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "null"}]},
    "canary_gate_authority_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "terminal_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "terminal_receipt_path": {"anyOf": [{"$ref": "#/$defs/absolutePath"}, {"type": "null"}]},
    "terminal_outcome": {"type": ["string", "null"]},
    "terminal_error_code": {"type": ["string", "null"]},
    "formal_write_count": {"const": 0},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"},
        "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-production-canary-queue"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
