{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/english-legacy-sol-item-recovery-receipt-v1.json",
  "title": "English Legacy Sol Item Recovery Receipt v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "issue_id", "batch_id", "batch_sha256", "subject",
    "target_id", "target_kind", "ordinal", "prior_fencing_token",
    "new_fencing_token", "attempt", "previous_checkpoint_sha256",
    "failure_receipt_sha256", "recovery_position_sha256", "authority_checkpoint_sha256", "status",
    "formal_write_count", "recovered_at", "seal"
  ],
  "properties": {
    "schema_version": {"const": "english_legacy_sol_item_recovery_receipt_v1"},
    "issue_id": {"const": "EN-P0-006"}, "batch_id": {"type": "string", "minLength": 1},
    "batch_sha256": {"$ref": "#/$defs/sha256"}, "subject": {"const": "english"},
    "target_id": {"type": "string", "minLength": 1},
    "target_kind": {"enum": ["master_bank_row", "sentence_pattern_card", "article_learning_page"]},
    "ordinal": {"type": "integer", "minimum": 1},
    "prior_fencing_token": {"type": "integer", "minimum": 1},
    "new_fencing_token": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 2},
    "previous_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "failure_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_position_sha256": {"$ref": "#/$defs/sha256"},
    "authority_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "resumed"}, "formal_write_count": {"const": 0},
    "recovered_at": {"type": "string", "minLength": 1}, "seal": {"$ref": "#/$defs/seal"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seal": {"type": "object", "additionalProperties": false,
      "required": ["algorithm", "purpose", "hmac_sha256"],
      "properties": {"algorithm": {"const": "HMAC-SHA256"},
        "purpose": {"const": "english-legacy-sol-item-recovery-receipt-v1"}, "hmac_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
