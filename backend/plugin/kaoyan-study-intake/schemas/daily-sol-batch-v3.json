{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/daily-sol-batch-v3.json",
  "title": "Daily Sol batch v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "subject", "study_date",
    "subject_luna_batch", "subject_luna_batch_sha256",
    "sol_candidate_task_ids", "sol_handoff_envelope_sha256s",
    "diagnostic_task_ids", "authorization_receipt",
    "authorization_receipt_sha256", "writer_adapter", "idempotency_key",
    "status", "formal_write_count"
  ],
  "properties": {
    "schema_version": {"const": "daily_sol_batch_v3"},
    "batch_id": {"$ref": "#/$defs/nonempty"},
    "subject": {"$ref": "#/$defs/subject"},
    "study_date": {"$ref": "#/$defs/nonempty"},
    "subject_luna_batch": {"$ref": "subject-luna-batch-v2.json"},
    "subject_luna_batch_sha256": {"$ref": "#/$defs/sha256"},
    "sol_candidate_task_ids": {"$ref": "#/$defs/uniqueIds"},
    "sol_handoff_envelope_sha256s": {"$ref": "#/$defs/uniqueHashes"},
    "diagnostic_task_ids": {"$ref": "#/$defs/uniqueIds"},
    "authorization_receipt": {"$ref": "user-sol-authorization-receipt-v2.json"},
    "authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "writer_adapter": {
      "enum": [
        "math_nightly_writer_v1", "cs408_daily_intake_writer_v1",
        "english_daily_intake_writer_v1"
      ]
    },
    "idempotency_key": {"$ref": "#/$defs/nonempty"},
    "status": {"const": "authorized"},
    "formal_write_count": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "uniqueIds": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "uniqueHashes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    }
  }
}
