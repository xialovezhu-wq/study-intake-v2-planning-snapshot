{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-review-candidate-package-v1",
  "type": "object",
  "required": [
    "schema_version", "unit_sha256", "lease_fence", "subject",
    "capture_id", "content_processing_id", "release_id",
    "loaded_core_sha256", "task", "model_contract", "pipeline",
    "analysis", "critical_review", "stage_runtime", "terminal_status",
    "execution_status", "quality_status", "production_accepted",
    "report_available", "report_disposition", "sol_review_status",
    "formal_write_eligible", "review_result", "findings", "warnings",
    "formal_write_count"
  ],
  "properties": {
    "schema_version": {
      "const": "study-intake-review-candidate-package-v1"
    },
    "unit_sha256": {"$ref": "#/$defs/sha256"},
    "lease_fence": {"type": "integer", "minimum": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "capture_id": {"type": "string", "minLength": 1},
    "content_processing_id": {"$ref": "#/$defs/nullable_sha256"},
    "release_id": {"$ref": "#/$defs/sha256"},
    "loaded_core_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "task": {
      "type": "object",
      "required": [
        "schema_version", "frozen_payload", "requested_model",
        "requested_reasoning_effort", "unit_sha256"
      ],
      "properties": {
        "schema_version": {"const": "study-intake-frozen-task-v1"},
        "frozen_payload": {
          "type": "object", "minProperties": 1
        },
        "requested_model": {"const": "gpt-5.6-luna"},
        "requested_reasoning_effort": {"const": "max"},
        "unit_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "model_contract": {
      "type": "object",
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": {"const": "gpt-5.6-luna"},
        "reasoning_effort": {"const": "max"}
      },
      "additionalProperties": false
    },
    "pipeline": {
      "oneOf": [
        {"const": ["analysis"]},
        {"const": ["analysis", "critical_review"]}
      ]
    },
    "analysis": {"type": "object", "minProperties": 1},
    "critical_review": {
      "oneOf": [
        {"type": "object", "minProperties": 1},
        {"type": "null"}
      ]
    },
    "stage_runtime": {
      "type": "object",
      "required": ["analysis", "critical_review"],
      "properties": {
        "analysis": {"$ref": "#/$defs/review_stage_runtime"},
        "critical_review": {
          "oneOf": [
            {"$ref": "#/$defs/review_stage_runtime"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "terminal_status": {"enum": ["needs_sol_review", "quarantined"]},
    "execution_status": {"enum": ["succeeded", "failed"]},
    "quality_status": {"enum": ["issues_found", "unchecked"]},
    "production_accepted": {"const": false},
    "report_available": {"const": true},
    "report_disposition": {
      "enum": ["needs_sol_review", "quarantined"]
    },
    "sol_review_status": {"enum": ["pending", "not_eligible"]},
    "formal_write_eligible": {"const": false},
    "review_result": {
      "type": "object",
      "required": ["status", "error_code"],
      "properties": {
        "status": {"enum": ["needs_sol_review", "quarantined"]},
        "error_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {"type": "object", "minProperties": 1}
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "minProperties": 1}
    },
    "formal_write_count": {"const": 0}
  },
  "allOf": [
    {
      "if": {
        "properties": {"critical_review": {"type": "null"}},
        "required": ["critical_review"]
      },
      "then": {
        "properties": {
          "pipeline": {"const": ["analysis"]},
          "stage_runtime": {
            "properties": {"critical_review": {"type": "null"}}
          }
        }
      },
      "else": {
        "properties": {
          "pipeline": {"const": ["analysis", "critical_review"]},
          "stage_runtime": {
            "properties": {
              "critical_review": {"$ref": "#/$defs/review_stage_runtime"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"terminal_status": {"const": "needs_sol_review"}},
        "required": ["terminal_status"]
      },
      "then": {
        "properties": {
          "execution_status": {"const": "succeeded"},
          "quality_status": {"const": "issues_found"},
          "findings": {"minItems": 1},
          "report_disposition": {"const": "needs_sol_review"},
          "sol_review_status": {"const": "pending"},
          "review_result": {
            "properties": {"status": {"const": "needs_sol_review"}}
          }
        }
      },
      "else": {
        "properties": {
          "execution_status": {"const": "failed"},
          "quality_status": {"const": "unchecked"},
          "findings": {"maxItems": 0},
          "report_disposition": {"const": "quarantined"},
          "sol_review_status": {"const": "not_eligible"},
          "review_result": {
            "properties": {"status": {"const": "quarantined"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "review_stage_runtime": {
      "type": "object",
      "required": [
        "requested_model", "requested_reasoning_effort",
        "runtime_identity_status", "duration_ms", "semantic_stage_count",
        "provider_request_count", "mcp_tool_call_count", "model_call_count",
        "raw_output_object_sha256", "raw_output_object_ref",
        "stage_execution_receipt_sha256", "stage_execution_receipt_ref",
        "stage_normalization_receipt_sha256",
        "stage_normalization_receipt_ref", "normalization_status",
        "normalization_warning_count", "normalization_warnings",
        "review_mcp_transcript_sha256", "review_mcp_transcript_ref"
      ],
      "properties": {
        "requested_model": {"const": "gpt-5.6-luna"},
        "requested_reasoning_effort": {"const": "max"},
        "runtime_identity_status": {
          "enum": ["confirmed", "requested_unverified", "quarantined"]
        },
        "duration_ms": {"type": "integer", "minimum": 0},
        "semantic_stage_count": {"const": 1},
        "provider_request_count": {"type": "integer", "minimum": 2},
        "mcp_tool_call_count": {"type": "integer", "minimum": 1},
        "model_call_count": {"const": 1},
        "raw_output_object_sha256": {"$ref": "#/$defs/sha256"},
        "raw_output_object_ref": {
          "type": "string",
          "pattern": "^study-intake-model-stage-raw-output://sha256/[0-9a-f]{64}$"
        },
        "stage_execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "stage_execution_receipt_ref": {
          "type": "string",
          "pattern": "^study-intake-model-stage-execution://sha256/[0-9a-f]{64}$"
        },
        "stage_normalization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "stage_normalization_receipt_ref": {
          "type": "string",
          "pattern": "^study-intake-model-stage-normalization://sha256/[0-9a-f]{64}$"
        },
        "normalization_status": {
          "enum": ["normalized", "normalized_with_warnings"]
        },
        "normalization_warning_count": {"type": "integer", "minimum": 0},
        "normalization_warnings": {"type": "array"},
        "review_mcp_transcript_sha256": {"$ref": "#/$defs/sha256"},
        "review_mcp_transcript_ref": {
          "type": "string",
          "pattern": "^study-intake-mcp-stage-transcript://sha256/[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
