{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/english-legacy-recuration-sol-batch-v1.json",
  "title": "English Legacy Recuration Sol Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "issue_id", "batch_id", "subject",
    "batch_authorization_sha256", "authorization_expansion_closure_sha256",
    "inventory_sha256", "target_set_sha256",
    "target_count", "authority_generation", "authority_fingerprint",
    "authorized_at", "work_items", "status", "formal_write_count"
  ],
  "properties": {
    "schema_version": {"const": "english_legacy_recuration_sol_batch_v1"},
    "issue_id": {"const": "EN-P0-006"},
    "batch_id": {"type": "string", "minLength": 1},
    "subject": {"const": "english"},
    "batch_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_expansion_closure_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "target_set_sha256": {"$ref": "#/$defs/sha256"},
    "target_count": {"type": "integer", "minimum": 1},
    "authority_generation": {"type": "string", "minLength": 1},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "authorized_at": {"type": "string", "minLength": 1},
    "work_items": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work_item"}
    },
    "status": {"const": "authorized"},
    "formal_write_count": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "parent_batch_authorization_sha256",
        "inventory_sha256", "authorization_event_sha256",
        "target_authorization_receipt_sha256", "target_id", "target_kind",
        "ordinal", "current_object_sha256", "work_item_sha256",
        "authority_generation", "authority_fingerprint", "proposal_sha256",
        "package_sha256", "quality_receipt_sha256", "status",
        "luna_terminal", "quality_passed", "quality_outcome",
        "proposed_action", "model_call_count", "formal_write_count",
        "idempotency_key"
      ],
      "properties": {
        "schema_version": {"const": "english_legacy_sol_work_item_v1"},
        "parent_batch_authorization_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_event_sha256": {"$ref": "#/$defs/sha256"},
        "target_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "target_id": {"type": "string", "minLength": 1},
        "target_kind": {"enum": ["master_bank_row", "sentence_pattern_card", "article_learning_page"]},
        "ordinal": {"type": "integer", "minimum": 1},
        "current_object_sha256": {"$ref": "#/$defs/sha256"},
        "work_item_sha256": {"$ref": "#/$defs/sha256"},
        "authority_generation": {"type": "string", "minLength": 1},
        "authority_fingerprint": {"$ref": "#/$defs/sha256"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "quality_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "quality_passed"},
        "luna_terminal": {"const": true},
        "quality_passed": {"const": true},
        "quality_outcome": {"enum": ["accepted", "corrected"]},
        "proposed_action": {"enum": ["update_existing_proposal", "already_current_proposal"]},
        "model_call_count": {"const": 2},
        "formal_write_count": {"const": 0},
        "idempotency_key": {"type": "string", "minLength": 1}
      }
    }
  }
}
