{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-production-canary-queue-entry-v2",
  "type": "object",
  "required": [
    "activation_id", "authority", "canary_gate_authority_sha256", "canary_gate_path",
    "canary_gate_sha256", "claimed_at", "context_root", "discovered_at", "finished_at",
    "formal_write_count", "frozen_payload_sha256", "lease_fence", "lease_owner_id",
    "mcp_session_root", "process_identity_path", "process_identity_sha256",
    "producer_authority_fingerprint", "producer_high_watermark_sha256",
    "producer_input_contract_sha256", "producer_recorded_at", "producer_unit_id",
    "queue_status", "release_id", "report_root", "schema_version", "source_event_ids",
    "source_event_set_sha256", "subject", "task_object_path", "task_object_sha256",
    "terminal_error_code", "terminal_outcome", "terminal_receipt_path",
    "terminal_receipt_sha256", "unit_sha256"
  ],
  "properties": {
    "activation_id": {"$ref": "#/$defs/sha256"},
    "authority": {"$ref": "#/$defs/authority"},
    "canary_gate_authority_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "canary_gate_path": {"$ref": "#/$defs/nullable_absolute_path"},
    "canary_gate_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "claimed_at": {"$ref": "#/$defs/nullable_timestamp"},
    "context_root": {"$ref": "#/$defs/nullable_absolute_path"},
    "discovered_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/nullable_timestamp"},
    "formal_write_count": {"const": 0},
    "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
    "lease_fence": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "lease_owner_id": {"$ref": "#/$defs/nullable_nonempty_string"},
    "mcp_session_root": {"$ref": "#/$defs/nullable_absolute_path"},
    "process_identity_path": {"$ref": "#/$defs/nullable_absolute_path"},
    "process_identity_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "producer_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "producer_high_watermark_sha256": {"$ref": "#/$defs/sha256"},
    "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"},
    "producer_recorded_at": {"$ref": "#/$defs/timestamp"},
    "producer_unit_id": {"type": "string", "minLength": 1},
    "queue_status": {"enum": ["pending", "claimed", "succeeded", "failed"]},
    "release_id": {"$ref": "#/$defs/sha256"},
    "report_root": {"$ref": "#/$defs/nullable_absolute_path"},
    "schema_version": {"const": "study-intake-production-canary-queue-entry-v2"},
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
    "subject": {"$ref": "#/$defs/subject"},
    "task_object_path": {"$ref": "#/$defs/absolute_path"},
    "task_object_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_error_code": {"$ref": "#/$defs/nullable_nonempty_string"},
    "terminal_outcome": {"enum": ["succeeded", "failed", "cancelled", "timed_out", "needs_rework", null]},
    "terminal_receipt_path": {"$ref": "#/$defs/nullable_absolute_path"},
    "terminal_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "unit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"canary_gate_sha256": {"type": "null"}}, "required": ["canary_gate_sha256"]},
      "then": {
        "properties": {
          "canary_gate_path": {"type": "null"},
          "canary_gate_authority_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "canary_gate_path": {"$ref": "#/$defs/absolute_path"},
          "canary_gate_authority_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"process_identity_sha256": {"type": "null"}}, "required": ["process_identity_sha256"]},
      "then": {"properties": {"process_identity_path": {"type": "null"}}},
      "else": {"properties": {"process_identity_path": {"$ref": "#/$defs/absolute_path"}}}
    },
    {
      "if": {"properties": {"terminal_receipt_sha256": {"type": "null"}}, "required": ["terminal_receipt_sha256"]},
      "then": {"properties": {"terminal_receipt_path": {"type": "null"}}},
      "else": {"properties": {"terminal_receipt_path": {"$ref": "#/$defs/absolute_path"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "nullable_timestamp": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "absolute_path": {"type": "string", "pattern": "^/", "minLength": 2},
    "nullable_absolute_path": {"oneOf": [{"$ref": "#/$defs/absolute_path"}, {"type": "null"}]},
    "nullable_nonempty_string": {"type": ["string", "null"], "minLength": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "authority": {
      "type": "object",
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"},
        "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-production-canary-queue"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
