{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/subject-resume-evidence-v1.json",
  "title": "Single subject resume evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "subject",
    "release_id",
    "mcp_authority_fingerprint",
    "mcp_read_completed",
    "mcp_read_call_count",
    "analysis_completed",
    "report_generated",
    "report_sha256",
    "requested_service_tier",
    "effective_service_tier",
    "model_call_count",
    "provider_request_count",
    "real_luna_run_count",
    "formal_surface_sha256",
    "formal_write_count",
    "sol_enabled",
    "production_accepted",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-subject-resume-evidence-v1"},
    "status": {"const": "passed"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "release_id": {"$ref": "#/$defs/sha256"},
    "mcp_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "mcp_read_completed": {"const": true},
    "mcp_read_call_count": {"type": "integer", "minimum": 1},
    "analysis_completed": {"const": true},
    "report_generated": {"const": true},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "requested_service_tier": {"const": "priority"},
    "effective_service_tier": {
      "enum": ["priority", "requested_unverified"]
    },
    "model_call_count": {"type": "integer", "minimum": 1},
    "provider_request_count": {"type": "integer", "minimum": 1},
    "real_luna_run_count": {"type": "integer", "minimum": 1},
    "formal_surface_sha256": {"$ref": "#/$defs/sha256"},
    "formal_write_count": {"const": 0},
    "sol_enabled": {"const": false},
    "production_accepted": {"const": false},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
