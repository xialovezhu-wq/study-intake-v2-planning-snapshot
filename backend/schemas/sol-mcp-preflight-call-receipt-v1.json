{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiazhibin.local/schemas/sol-mcp-preflight-call-receipt-v1.json",
  "title": "Sol MCP preflight call receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "preflight_session_id",
    "subject",
    "call_index",
    "tool_name",
    "arguments_sha256",
    "result_sha256",
    "result_summary",
    "started_at",
    "completed_at",
    "status",
    "read_call_count",
    "write_call_count",
    "formal_write_count",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "sol-mcp-preflight-call-receipt-v1"},
    "purpose": {"const": "infrastructure_preflight"},
    "preflight_session_id": {"type": "string"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "call_index": {"type": "integer", "minimum": 1},
    "tool_name": {"enum": ["list_records", "get_records", "search_records", "query_relations"]},
    "arguments_sha256": {"$ref": "#/$defs/sha"},
    "result_sha256": {"$ref": "#/$defs/sha"},
    "result_summary": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed"]},
    "read_call_count": {"const": 1},
    "write_call_count": {"const": 0},
    "formal_write_count": {"const": 0},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
