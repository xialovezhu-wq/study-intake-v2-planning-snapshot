{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subject_background_luna_rollover_receipt_v2",
  "type": "object",
  "required": [
    "schema_version", "rollover_id", "mode", "subject", "old_batch_id",
    "old_batch_sha256", "old_batch_snapshot_sha256", "old_batch_snapshot_path",
    "old_batch_revision", "archive_sha256", "archive_path", "task_set_sha256",
    "task_count", "terminal_status_counts", "quality_receipt_sha256s",
    "terminal_receipt_sha256s", "evidence_reference_set_sha256",
    "source_generation", "source_authority_fingerprint", "next_generation",
    "next_authority_fingerprint", "original_preclaim_failure_receipt_sha256",
    "original_preclaim_failure_receipt_path", "preserved_queue_entry_sha256",
    "preserved_queue_identity", "canary_state_before",
    "canary_state_before_sha256", "subsequent_attempt_receipt_sha256s",
    "preserved_task", "writer_revision_before", "writer_revision_after",
    "writer_state_before", "writer_state_before_sha256", "writer_state_after",
    "writer_state_after_sha256", "batch_pointer_before",
    "batch_pointer_before_sha256", "background_rollover_pointer_before",
    "background_rollover_pointer_before_sha256", "rollback_token", "sol_called",
    "sol_enabled", "model_call_count", "provider_request_count",
    "mcp_tool_call_count", "formal_write_count", "created_at", "seal"
  ],
  "properties": {
    "schema_version": {"const": "subject_background_luna_rollover_receipt_v2"},
    "rollover_id": {"$ref": "#/$defs/sha256"},
    "mode": {"const": "explicit_failure_resume"},
    "subject": {"const": "english"},
    "old_batch_id": {"type": "string", "minLength": 1},
    "old_batch_sha256": {"$ref": "#/$defs/sha256"},
    "old_batch_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "old_batch_snapshot_path": {"$ref": "#/$defs/absolute_path"},
    "old_batch_revision": {"type": "integer", "minimum": 0},
    "archive_sha256": {"$ref": "#/$defs/sha256"},
    "archive_path": {"$ref": "#/$defs/absolute_path"},
    "task_set_sha256": {"$ref": "#/$defs/sha256"},
    "task_count": {"type": "integer", "minimum": 1},
    "terminal_status_counts": {"type": "object"},
    "quality_receipt_sha256s": {"$ref": "#/$defs/sha256_array"},
    "terminal_receipt_sha256s": {"$ref": "#/$defs/sha256_array"},
    "evidence_reference_set_sha256": {"$ref": "#/$defs/sha256"},
    "source_generation": {"type": "string", "minLength": 1},
    "source_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "next_generation": {"type": "string", "minLength": 1},
    "next_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "original_preclaim_failure_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "original_preclaim_failure_receipt_path": {"$ref": "#/$defs/absolute_path"},
    "preserved_queue_entry_sha256": {"$ref": "#/$defs/sha256"},
    "preserved_queue_identity": {"type": "object"},
    "canary_state_before": {"type": "object"},
    "canary_state_before_sha256": {"$ref": "#/$defs/sha256"},
    "subsequent_attempt_receipt_sha256s": {"$ref": "#/$defs/sha256_array"},
    "preserved_task": {"type": "object"},
    "writer_revision_before": {"type": "integer", "minimum": 0},
    "writer_revision_after": {"type": "integer", "minimum": 1},
    "writer_state_before": {"type": "object"},
    "writer_state_before_sha256": {"$ref": "#/$defs/sha256"},
    "writer_state_after": {"type": "object"},
    "writer_state_after_sha256": {"$ref": "#/$defs/sha256"},
    "batch_pointer_before": {"type": "object"},
    "batch_pointer_before_sha256": {"$ref": "#/$defs/sha256"},
    "background_rollover_pointer_before": {"type": ["object", "null"]},
    "background_rollover_pointer_before_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "rollback_token": {"$ref": "#/$defs/sha256"},
    "sol_called": {"const": false},
    "sol_enabled": {"const": false},
    "model_call_count": {"const": 0},
    "provider_request_count": {"const": 0},
    "mcp_tool_call_count": {"const": 0},
    "formal_write_count": {"const": 0},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "seal": {"$ref": "#/$defs/seal"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "absolute_path": {"type": "string", "pattern": "^/", "minLength": 2},
    "sha256_array": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "seal": {
      "type": "object",
      "required": ["algorithm", "purpose", "hmac_sha256"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "purpose": {"const": "subject-background-luna-rollover-v2"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
