{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study intake dashboard projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "study_date", "dispatchers", "subjects"],
  "properties": {
    "schema_version": {"const": "study-intake-dashboard-projection-v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "study_date": {"type": "string", "format": "date"},
    "dispatchers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["math", "cs408", "english"],
      "properties": {
        "math": {"$ref": "#/$defs/dispatcher"},
        "cs408": {"$ref": "#/$defs/dispatcher"},
        "english": {"$ref": "#/$defs/dispatcher"}
      }
    },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["math", "cs408", "english"],
      "properties": {
        "math": {"$ref": "#/$defs/subject"},
        "cs408": {"$ref": "#/$defs/subject"},
        "english": {"$ref": "#/$defs/subject"}
      }
    }
  },
  "$defs": {
    "dispatcher": {
      "type": "object",
      "required": [
        "status",
        "last_heartbeat",
        "release_id",
        "active_release_id",
        "heartbeat_release_id",
        "heartbeat_generation_status",
        "previous_release_heartbeat",
        "requested_model",
        "requested_reasoning_effort"
      ],
      "properties": {
        "status": {"enum": ["starting", "running", "stopping", "failed"]},
        "last_heartbeat": {"type": "string", "format": "date-time"},
        "release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "active_release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "heartbeat_release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "heartbeat_generation_status": {"enum": ["current_release", "previous_release_heartbeat"]},
        "previous_release_heartbeat": {"type": "boolean"},
        "plugin_id": {"type": "string", "const": "kaoyan-study-intake"},
        "plugin_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "plugin_component_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "processing_skill_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "processing_skill_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "processing_skill_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mcp_server_id": {"enum": ["kaoyan_math_read", "kaoyan_cs408_read", "kaoyan_english_read"]},
        "mcp_server_release": {"type": "string", "pattern": "^0\\.3\\.0\\+sha256\\.[0-9a-f]{64}$"},
        "minimum_mcp_server_release": {"type": "string", "minLength": 1, "maxLength": 160},
        "requested_model": {"const": "gpt-5.6-luna"},
        "requested_reasoning_effort": {"const": "max"},
        "paused": {"type": "boolean"},
        "current_stage": {"$ref": "#/$defs/stage"},
        "last_error_code": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}
      }
    },
    "stage": {
      "enum": [
        "idle",
        "frozen_evidence",
        "queued",
        "dispatching",
        "analysis",
        "critical_review",
        "publishing",
        "complete",
        "evidence_validation",
        "package_ready",
        "failed",
        "stale"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "queued",
        "running",
        "ready",
        "failed",
        "stale",
        "evidence_pending"
      ],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "queued": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "ready": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "stale": {"type": "integer", "minimum": 0},
        "evidence_pending": {"type": "integer", "minimum": 0}
      }
    },
    "subject": {
      "type": "object",
      "required": ["enabled", "status", "current_stage", "counts", "items", "metrics", "metric_sources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "status": {"enum": ["active", "disabled", "source_error"]},
        "current_stage": {"$ref": "#/$defs/stage"},
        "counts": {"$ref": "#/$defs/counts"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capture_id",
              "subject",
              "study_date",
              "queue_state",
              "unit_sha256",
              "input_fingerprint",
              "frozen_payload_sha256",
              "release_id",
              "rule_version",
              "server_queue_status"
            ],
            "properties": {
              "capture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
              "subject": {"enum": ["math", "cs408", "english"]},
              "study_date": {"type": "string", "format": "date"},
              "queue_state": {"enum": ["queued", "running", "ready", "failed", "stale", "evidence_pending"]},
              "current_stage": {"$ref": "#/$defs/stage"},
              "unit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "input_fingerprint": {"type": "string", "minLength": 1, "maxLength": 320},
              "frozen_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "rule_version": {"type": "string", "minLength": 1, "maxLength": 160},
              "rule_version_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "target_label": {"type": "string", "minLength": 1, "maxLength": 160},
              "started_at": {"type": "string", "format": "date-time"},
              "last_state_change_at": {"type": "string", "format": "date-time"},
              "elapsed_seconds": {"type": "integer", "minimum": 0},
              "local_model_submitted": {"type": "boolean"},
              "server_queue_status": {"enum": ["unknown", "rate_limited"]},
              "server_queue_confirmation": {"enum": ["unconfirmed", "confirmed_event"]},
              "task_detail_path": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        },
        "metrics": {"type": "object"},
        "metric_sources": {"type": "object"},
        "error_code": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}
      }
    }
  }
}
