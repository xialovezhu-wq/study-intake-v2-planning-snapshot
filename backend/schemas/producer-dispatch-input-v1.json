{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/producer-dispatch-input-v1.json",
  "title": "Producer to dispatcher input contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "subject", "release_id", "authority_fingerprint",
    "producer_unit_id", "producer_recorded_at", "input_fingerprint",
    "source_events", "earliest_source_recorded_at",
    "latest_source_recorded_at", "source_event_set_sha256",
    "formal_write_count", "producer_input_contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-producer-dispatch-input-v1"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "release_id": {"$ref": "#/$defs/sha256"},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "producer_unit_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "producer_recorded_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_events": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/sourceEvent"}
    },
    "earliest_source_recorded_at": {"type": "string", "format": "date-time"},
    "latest_source_recorded_at": {"type": "string", "format": "date-time"},
    "source_event_set_sha256": {"$ref": "#/$defs/sha256"},
    "formal_write_count": {"const": 0},
    "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "recorded_at", "source_sha256"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "recorded_at": {"type": "string", "format": "date-time"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
