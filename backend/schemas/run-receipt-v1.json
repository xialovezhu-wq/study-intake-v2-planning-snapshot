{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study intake preprocessing attempt receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "job_id",
    "subject",
    "capture_id",
    "study_date",
    "attempt",
    "status",
    "started_at",
    "finished_at",
    "input_fingerprint",
    "requested_model",
    "requested_reasoning_effort",
    "formal_write_count"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-preprocess-receipt-v1"},
    "receipt_id": {"type": "string"},
    "job_id": {"type": "string"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "capture_id": {"type": "string"},
    "study_date": {"type": "string", "format": "date"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ready", "retrying", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_model": {"const": "gpt-5.6-luna"},
    "requested_reasoning_effort": {"const": "max"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "package_id": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "null"]},
    "provider_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_schema_ref": {"type": "string", "pattern": "^study-intake-provider-schema://sha256/[a-f0-9]{64}$"},
    "canonical_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "processing_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mcp_read_session_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mcp_read_session_receipt_ref": {"type": "string", "pattern": "^study-intake-mcp-read-session://sha256/[a-f0-9]{64}$"},
    "model_mcp_transport_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_mcp_transport_ref": {"type": "string", "pattern": "^study-intake-model-mcp-transport://sha256/[a-f0-9]{64}$"},
    "mcp_failure_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mcp_failure_receipt_ref": {"type": "string", "pattern": "^study-intake-mcp-read-session-call://sha256/[a-f0-9]{64}$"},
    "model_stage_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_stage_output_ref": {"type": "string", "pattern": "^study-intake-model-stage-output://sha256/[a-f0-9]{64}$"},
    "mcp_transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mcp_transcript_ref": {"type": "string", "pattern": "^study-intake-mcp-stage-transcript://sha256/[a-f0-9]{64}$"},
    "post_stage_validation_failed": {"type": "boolean", "const": true},
    "formal_write_count": {"const": 0}
  }
}
