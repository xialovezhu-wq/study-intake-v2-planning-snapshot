{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subject_background_luna_rollover_receipt_v1",
  "type": "object",
  "required": [
    "schema_version", "rollover_id", "mode", "subject", "old_batch_id",
    "old_batch_sha256", "old_batch_snapshot_sha256", "old_batch_snapshot_path",
    "old_batch_revision", "archive_sha256", "archive_path", "task_set_sha256",
    "task_count", "terminal_status_counts", "quality_receipt_sha256s",
    "terminal_receipt_sha256s", "evidence_reference_set_sha256",
    "authority_generation", "authority_fingerprint", "next_generation",
    "writer_revision_before", "writer_revision_after", "resume_acceptance_sha256",
    "sol_called", "sol_enabled", "model_call_count", "provider_request_count",
    "formal_write_count", "created_at", "seal"
  ],
  "properties": {
    "schema_version": {"const": "subject_background_luna_rollover_receipt_v1"},
    "rollover_id": {"$ref": "#/$defs/sha256"},
    "mode": {"enum": ["auto_success", "explicit_failure_resume"]},
    "subject": {"$ref": "#/$defs/subject"},
    "old_batch_id": {"type": "string", "minLength": 1},
    "old_batch_sha256": {"$ref": "#/$defs/sha256"},
    "old_batch_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "old_batch_snapshot_path": {"$ref": "#/$defs/absolute_path"},
    "old_batch_revision": {"type": "integer", "minimum": 0},
    "archive_sha256": {"$ref": "#/$defs/sha256"},
    "archive_path": {"$ref": "#/$defs/absolute_path"},
    "task_set_sha256": {"$ref": "#/$defs/sha256"},
    "task_count": {"type": "integer", "minimum": 1},
    "terminal_status_counts": {"$ref": "#/$defs/terminal_status_counts"},
    "quality_receipt_sha256s": {"$ref": "#/$defs/sha256_array"},
    "terminal_receipt_sha256s": {"$ref": "#/$defs/sha256_array"},
    "evidence_reference_set_sha256": {"$ref": "#/$defs/sha256"},
    "authority_generation": {"type": "string", "minLength": 1},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "next_generation": {"type": "string", "minLength": 1},
    "writer_revision_before": {"type": "integer", "minimum": 0},
    "writer_revision_after": {"type": "integer", "minimum": 0},
    "resume_acceptance_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "sol_called": {"const": false},
    "sol_enabled": {"const": false},
    "model_call_count": {"const": 0},
    "provider_request_count": {"const": 0},
    "formal_write_count": {"const": 0},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "seal": {"$ref": "#/$defs/seal"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "auto_success"}}, "required": ["mode"]},
      "then": {"properties": {"resume_acceptance_sha256": {"type": "null"}}},
      "else": {"properties": {"resume_acceptance_sha256": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "absolute_path": {"type": "string", "pattern": "^/", "minLength": 2},
    "subject": {"enum": ["math", "cs408", "english"]},
    "sha256_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "terminal_status_counts": {
      "type": "object",
      "required": ["quality_passed", "needs_rework", "failed", "evidence_pending"],
      "properties": {
        "quality_passed": {"type": "integer", "minimum": 0},
        "needs_rework": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "evidence_pending": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "seal": {
      "type": "object",
      "required": ["algorithm", "purpose", "hmac_sha256"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "purpose": {"const": "subject-background-luna-rollover"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
