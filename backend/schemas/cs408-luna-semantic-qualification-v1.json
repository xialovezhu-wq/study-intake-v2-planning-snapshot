{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.study-intake.invalid/cs408-luna-semantic-qualification-v1.json",
  "title": "CS408 Luna Semantic Qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "capture_id",
    "analysis_output_sha256",
    "critical_review_output_sha256",
    "analysis_transcript_sha256",
    "critical_review_transcript_sha256",
    "analysis_output_canonical_sha256",
    "critical_review_output_canonical_sha256",
    "analysis_transcript_canonical_sha256",
    "critical_review_transcript_canonical_sha256",
    "read_session_id",
    "read_session_manifest_sha256",
    "authority_generation",
    "authority_fingerprint",
    "fresh_context_proof_sha256",
    "semantic_analysis_status",
    "delivery_status",
    "delivery_detail",
    "critical_review_verdict",
    "intended_delivery_outcome",
    "identity_conflict_present",
    "executable_delivery_allowed",
    "semantic_coverage",
    "format_warnings",
    "qualification_reasons",
    "blocking_delivery_reasons",
    "legacy_failure_code",
    "sol_disabled",
    "formal_write_count",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "cs408-luna-semantic-qualification-v1"},
    "subject": {"const": "cs408"},
    "capture_id": {"type": "string", "minLength": 1},
    "analysis_output_sha256": {"$ref": "#/$defs/sha256"},
    "critical_review_output_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_transcript_sha256": {"$ref": "#/$defs/sha256"},
    "critical_review_transcript_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_output_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "critical_review_output_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_transcript_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "critical_review_transcript_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "read_session_id": {"type": "string", "minLength": 1},
    "read_session_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "authority_generation": {"type": "string", "minLength": 1},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "fresh_context_proof_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_analysis_status": {"enum": ["qualified", "unqualified"]},
    "delivery_status": {"enum": ["accepted", "corrected", "rejected", "validator_failed", "blocked"]},
    "delivery_detail": {"type": "string", "minLength": 1},
    "critical_review_verdict": {"enum": ["pass", "pass_with_warnings", "reject"]},
    "intended_delivery_outcome": {"enum": ["accepted", "corrected", "rejected", "blocked"]},
    "identity_conflict_present": {"type": "boolean"},
    "executable_delivery_allowed": {"type": "boolean"},
    "semantic_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_task_artifacts_complete",
        "critical_review_task_artifacts_complete",
        "analysis_pagination_complete",
        "critical_review_pagination_complete",
        "analysis_knowledge_lookup_complete",
        "critical_review_knowledge_lookup_complete",
        "analysis_item_identity_lookup_complete",
        "critical_review_item_identity_lookup_complete",
        "analysis_relation_lookup_complete",
        "critical_review_relation_lookup_complete",
        "analysis_stage_refs_exact",
        "critical_review_stage_refs_exact",
        "critical_review_analysis_refs_exact",
        "semantic_sections_complete",
        "fresh_critical_context_verified"
      ],
      "properties": {
        "analysis_task_artifacts_complete": {"type": "boolean"},
        "critical_review_task_artifacts_complete": {"type": "boolean"},
        "analysis_pagination_complete": {"type": "boolean"},
        "critical_review_pagination_complete": {"type": "boolean"},
        "analysis_knowledge_lookup_complete": {"type": "boolean"},
        "critical_review_knowledge_lookup_complete": {"type": "boolean"},
        "analysis_item_identity_lookup_complete": {"type": "boolean"},
        "critical_review_item_identity_lookup_complete": {"type": "boolean"},
        "analysis_relation_lookup_complete": {"type": "boolean"},
        "critical_review_relation_lookup_complete": {"type": "boolean"},
        "analysis_stage_refs_exact": {"type": "boolean"},
        "critical_review_stage_refs_exact": {"type": "boolean"},
        "critical_review_analysis_refs_exact": {"type": "boolean"},
        "semantic_sections_complete": {"type": "boolean"},
        "fresh_critical_context_verified": {"type": "boolean"}
      }
    },
    "format_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["json_path", "warning_code", "message", "raw_fragment_sha256", "semantic_sha256_before", "semantic_sha256_after", "machine_parseable", "structural_semantics_unchanged"],
        "properties": {
          "json_path": {"type": "string", "pattern": "^\\$\\."},
          "warning_code": {"enum": ["latex_render", "markdown_render", "escape_render", "whitespace_render"]},
          "message": {"type": "string", "minLength": 1},
          "raw_fragment_sha256": {"$ref": "#/$defs/sha256"},
          "semantic_sha256_before": {"$ref": "#/$defs/sha256"},
          "semantic_sha256_after": {"$ref": "#/$defs/sha256"},
          "machine_parseable": {"const": true},
          "structural_semantics_unchanged": {"const": true}
        }
      }
    },
    "qualification_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocking_delivery_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "legacy_failure_code": {"type": ["string", "null"]},
    "sol_disabled": {"const": true},
    "formal_write_count": {"const": 0},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
