{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-review-candidate-terminal-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "unit_sha256", "subject", "capture_id", "release_id",
    "package_ref", "package_sha256", "analysis", "critical_review",
    "stage_runtime", "terminal_status", "execution_status",
    "quality_status", "production_accepted", "report_available",
    "report_disposition", "sol_review_status", "formal_write_eligible",
    "review_result", "findings", "warnings", "formal_write_count"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-review-candidate-terminal-v1"},
    "unit_sha256": {"$ref": "#/$defs/sha256"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "capture_id": {"type": "string", "minLength": 1},
    "release_id": {"$ref": "#/$defs/sha256"},
    "package_ref": {"type": "string", "pattern": "^study-intake-dispatch-package://sha256/[0-9a-f]{64}$"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "analysis": {"type": "object"},
    "critical_review": {"type": ["object", "null"]},
    "stage_runtime": {
      "type": "object",
      "required": ["analysis", "critical_review"],
      "properties": {
        "analysis": {"type": "object"},
        "critical_review": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "terminal_status": {"enum": ["needs_sol_review", "quarantined"]},
    "execution_status": {"enum": ["succeeded", "failed"]},
    "quality_status": {"enum": ["issues_found", "unchecked"]},
    "production_accepted": {"const": false},
    "report_available": {"const": true},
    "report_disposition": {"enum": ["needs_sol_review", "quarantined"]},
    "sol_review_status": {"enum": ["pending", "not_eligible"]},
    "formal_write_eligible": {"const": false},
    "review_result": {
      "type": "object",
      "required": ["status", "error_code"],
      "properties": {
        "status": {"enum": ["needs_sol_review", "quarantined"]},
        "error_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {"type": "object", "minProperties": 1}
    },
    "warnings": {
      "type": "array", "minItems": 1,
      "items": {"type": "object"}
    },
    "formal_write_count": {"const": 0}
  },
  "allOf": [
    {
      "if": {
        "properties": {"terminal_status": {"const": "needs_sol_review"}},
        "required": ["terminal_status"]
      },
      "then": {
        "properties": {
          "execution_status": {"const": "succeeded"},
          "quality_status": {"const": "issues_found"},
          "findings": {"minItems": 1},
          "report_disposition": {"const": "needs_sol_review"},
          "sol_review_status": {"const": "pending"},
          "review_result": {
            "properties": {"status": {"const": "needs_sol_review"}}
          }
        }
      },
      "else": {
        "properties": {
          "execution_status": {"const": "failed"},
          "quality_status": {"const": "unchecked"},
          "findings": {"maxItems": 0},
          "report_disposition": {"const": "quarantined"},
          "sol_review_status": {"const": "not_eligible"},
          "review_result": {
            "properties": {"status": {"const": "quarantined"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
