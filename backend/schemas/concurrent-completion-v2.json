{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-concurrent-completion-v2",
  "type": "object",
  "required": [
    "authority", "capture_id", "content_processing_id", "finished_at", "lease_fence",
    "ledger_entry_path", "ledger_entry_sha256", "loaded_core_sha256", "model", "outcome",
    "package_path", "package_ref", "package_sha256", "process_execution", "reasoning_effort",
    "receipt_path", "receipt_sha256", "release_id", "report_json_ref",
    "report_json_sha256", "report_markdown_ref", "report_markdown_sha256", "rule_version",
    "rule_version_sha256", "schema_version", "subject", "unit_sha256"
  ],
  "properties": {
    "authority": {"$ref": "#/$defs/authority"},
    "capture_id": {"type": "string", "minLength": 1},
    "content_processing_id": {"$ref": "#/$defs/nullable_sha256"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "lease_fence": {"type": "integer", "minimum": 1},
    "ledger_entry_path": {"$ref": "#/$defs/absolute_path"},
    "ledger_entry_sha256": {"$ref": "#/$defs/sha256"},
    "loaded_core_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "model": {"const": "gpt-5.6-luna"},
    "outcome": {"enum": ["succeeded", "failed", "cancelled", "timed_out", "stalled", "needs_rework"]},
    "package_path": {"$ref": "#/$defs/nullable_absolute_path"},
    "package_ref": {"$ref": "#/$defs/nullable_package_ref"},
    "package_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "process_execution": {
      "oneOf": [{"$ref": "#/$defs/process_execution"}, {"type": "null"}]
    },
    "reasoning_effort": {"const": "max"},
    "receipt_path": {"$ref": "#/$defs/absolute_path"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "release_id": {"$ref": "#/$defs/sha256"},
    "report_json_ref": {"$ref": "#/$defs/nullable_report_json_ref"},
    "report_json_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "report_markdown_ref": {"$ref": "#/$defs/nullable_report_markdown_ref"},
    "report_markdown_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "rule_version": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "rule_version_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "schema_version": {"const": "study-intake-concurrent-completion-v2"},
    "subject": {"$ref": "#/$defs/subject"},
    "unit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "succeeded"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "package_path": {"$ref": "#/$defs/absolute_path"},
          "package_ref": {"$ref": "#/$defs/package_ref"},
          "package_sha256": {"$ref": "#/$defs/sha256"},
          "report_json_ref": {"$ref": "#/$defs/report_json_ref"},
          "report_json_sha256": {"$ref": "#/$defs/sha256"},
          "report_markdown_ref": {"$ref": "#/$defs/report_markdown_ref"},
          "report_markdown_sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {
          "package_path": {"const": null},
          "package_ref": {"const": null},
          "package_sha256": {"const": null},
          "report_json_ref": {"const": null},
          "report_json_sha256": {"const": null},
          "report_markdown_ref": {"const": null},
          "report_markdown_sha256": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"rule_version": {"type": "null"}}, "required": ["rule_version"]},
      "then": {"properties": {"rule_version_sha256": {"type": "null"}}},
      "else": {"properties": {"rule_version_sha256": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "minLength": 1},
    "absolute_path": {"type": "string", "pattern": "^/", "minLength": 2},
    "nullable_absolute_path": {"oneOf": [{"$ref": "#/$defs/absolute_path"}, {"type": "null"}]},
    "subject": {"enum": ["math", "cs408", "english"]},
    "package_ref": {"type": "string", "pattern": "^study-intake-dispatch-package://sha256/[0-9a-f]{64}$"},
    "nullable_package_ref": {"oneOf": [{"$ref": "#/$defs/package_ref"}, {"type": "null"}]},
    "report_json_ref": {"type": "string", "pattern": "^study-intake-report://sha256/[0-9a-f]{64}$"},
    "nullable_report_json_ref": {"oneOf": [{"$ref": "#/$defs/report_json_ref"}, {"type": "null"}]},
    "report_markdown_ref": {"type": "string", "pattern": "^study-intake-report-markdown://sha256/[0-9a-f]{64}$"},
    "nullable_report_markdown_ref": {"oneOf": [{"$ref": "#/$defs/report_markdown_ref"}, {"type": "null"}]},
    "authority": {
      "type": "object",
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"},
        "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-completion"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "provider_process_closure": {
      "type": "object",
      "required": [
        "provider_process_identity_sha256", "provider_process_identity_path",
        "provider_process_exit_sha256", "provider_process_exit_path", "provider_pid",
        "provider_pgid", "process_start_token", "returncode", "termination_reason",
        "reaped", "process_absent", "pgid_absent"
      ],
      "properties": {
        "provider_process_identity_sha256": {"$ref": "#/$defs/sha256"},
        "provider_process_identity_path": {"$ref": "#/$defs/absolute_path"},
        "provider_process_exit_sha256": {"$ref": "#/$defs/sha256"},
        "provider_process_exit_path": {"$ref": "#/$defs/absolute_path"},
        "provider_pid": {"type": "integer", "minimum": 2},
        "provider_pgid": {"type": "integer", "minimum": 2},
        "process_start_token": {"type": "string", "minLength": 1},
        "returncode": {"type": "integer"},
        "termination_reason": {"type": "string", "minLength": 1},
        "reaped": {"const": true},
        "process_absent": {"const": true},
        "pgid_absent": {"const": true}
      },
      "additionalProperties": false
    },
    "process_execution": {
      "type": "object",
      "required": [
        "supervisor_process_identity_sha256", "supervisor_process_identity_path",
        "supervisor_process_exit_sha256", "supervisor_process_exit_path", "supervisor_pid",
        "supervisor_pgid", "process_start_token", "launch_nonce", "launched_at", "finished_at",
        "returncode", "termination_reason", "reaped", "process_absent", "pgid_absent",
        "canonical_task_runner", "provider_process_closure_required", "provider_stages"
      ],
      "properties": {
        "supervisor_process_identity_sha256": {"$ref": "#/$defs/sha256"},
        "supervisor_process_identity_path": {"$ref": "#/$defs/absolute_path"},
        "supervisor_process_exit_sha256": {"$ref": "#/$defs/sha256"},
        "supervisor_process_exit_path": {"$ref": "#/$defs/absolute_path"},
        "supervisor_pid": {"type": "integer", "minimum": 2},
        "supervisor_pgid": {"type": "integer", "minimum": 2},
        "process_start_token": {"type": "string", "minLength": 1},
        "launch_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "launched_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"$ref": "#/$defs/timestamp"},
        "returncode": {"type": "integer"},
        "termination_reason": {"type": "string", "minLength": 1},
        "reaped": {"const": true},
        "process_absent": {"const": true},
        "pgid_absent": {"const": true},
        "canonical_task_runner": {"type": "boolean"},
        "provider_process_closure_required": {"type": "boolean"},
        "provider_stages": {
          "type": "object",
          "patternProperties": {
            "^(math|cs408|english)_(analysis|critical_review)$": {"$ref": "#/$defs/provider_process_closure"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"canonical_task_runner": {"const": true}}, "required": ["canonical_task_runner"]},
          "then": {"properties": {"provider_process_closure_required": {"const": true}, "provider_stages": {"minProperties": 2, "maxProperties": 2}}},
          "else": {"properties": {"provider_process_closure_required": {"const": false}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
