{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-dispatch-report-v1",
  "type": "object",
  "required": [
    "analysis",
    "capture_id",
    "critical_review",
    "formal_write_count",
    "package_ref",
    "package_sha256",
    "release_id",
    "schema_version",
    "subject",
    "unit_sha256"
  ],
  "properties": {
    "analysis": {
      "type": "object",
      "minProperties": 1
    },
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "critical_review": {
      "type": "object",
      "minProperties": 1
    },
    "formal_write_count": {
      "const": 0
    },
    "package_ref": {
      "type": "string",
      "pattern": "^study-intake-dispatch-package://sha256/[0-9a-f]{64}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": "study-intake-dispatch-report-v1"
    },
    "subject": {
      "enum": ["math", "cs408", "english"]
    },
    "unit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
