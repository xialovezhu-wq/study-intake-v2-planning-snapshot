{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/orchestration-read-plan-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "subject", "capture_id", "frozen_task_sha256", "release_id", "activation_id", "authority_snapshot_sha256", "generation", "orchestrate_skill", "terra_agent_contract_sha256", "created_at", "branches", "formal_write_count", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "orchestration_read_plan_v1"}, "plan_id": {"type": "string", "minLength": 1},
    "subject": {"enum": ["math", "cs408", "english"]}, "capture_id": {"type": "string", "minLength": 1},
    "frozen_task_sha256": {"$ref": "#/$defs/sha"}, "release_id": {"$ref": "#/$defs/sha"}, "activation_id": {"$ref": "#/$defs/sha"}, "authority_snapshot_sha256": {"$ref": "#/$defs/sha"},
    "generation": {"type": "string", "minLength": 1}, "orchestrate_skill": {"$ref": "#/$defs/component"}, "terra_agent_contract_sha256": {"$ref": "#/$defs/sha"},
    "created_at": {"type": "string", "format": "date-time"}, "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}},
    "formal_write_count": {"const": 0}, "plan_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "branch": {
      "type": "object", "additionalProperties": false,
      "required": ["branch_id", "purpose", "rationale", "required", "depends_on", "allowed_task_artifact_ids", "allowed_mcp_tools", "collection_scope", "query_constraints", "maximum_calls", "maximum_records", "maximum_bytes", "completion_requirements", "failure_policy", "expected_evidence_kinds"],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "required": {"type": "boolean"},
        "depends_on": {"$ref": "#/$defs/strings"}, "allowed_task_artifact_ids": {"$ref": "#/$defs/strings"},
        "allowed_mcp_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["get_task_context", "read_task_artifact", "list_records", "get_records", "search_records", "query_relations"]}},
        "collection_scope": {"$ref": "#/$defs/strings"}, "query_constraints": {"type": "object"},
        "maximum_calls": {"type": "integer", "minimum": 1}, "maximum_records": {"type": "integer", "minimum": 1}, "maximum_bytes": {"type": "integer", "minimum": 1},
        "completion_requirements": {"$ref": "#/$defs/strings"}, "failure_policy": {"enum": ["fail_closed", "report_issue", "optional_missing"]}, "expected_evidence_kinds": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
