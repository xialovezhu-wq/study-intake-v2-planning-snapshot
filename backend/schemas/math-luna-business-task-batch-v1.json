{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen mathematics Luna business task batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "root", "state", "task_count", "business_sample_type", "solution_evidence_policy", "authorization", "model_request", "tasks", "safety"],
  "properties": {
    "schema_version": {"const": "math-luna-business-task-batch-v1"},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "root": {"type": "string", "pattern": "^/"},
    "state": {"const": "ready_for_luna_business_processing"},
    "task_count": {"type": "integer", "minimum": 1},
    "business_sample_type": {"const": "real_math_learning_captures"},
    "solution_evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "business_fact", "solution_images_fabricated", "solution_text_copied_with_source_path_and_hash"],
      "properties": {
        "requirement": {"const": "solution_text_or_solution_image"},
        "business_fact": {"type": "string", "minLength": 1, "maxLength": 1000},
        "solution_images_fabricated": {"const": false},
        "solution_text_copied_with_source_path_and_hash": {"type": "boolean"}
      }
    },
    "authorization": {"$ref": "#/$defs/authorization"},
    "model_request": {"$ref": "#/$defs/model_request"},
    "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/task"}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_source_fixture_unchanged", "private_solution_and_dialogue_not_learner_facing", "luna_output_proposal_only", "formal_mutation_authorized"],
      "properties": {
        "frozen_source_fixture_unchanged": {"const": true},
        "private_solution_and_dialogue_not_learner_facing": {"const": true},
        "luna_output_proposal_only": {"const": true},
        "formal_mutation_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processing_authorized", "luna_authorized", "sol_authorized", "formal_write_count", "quick_intake_written", "scope"],
      "properties": {
        "processing_authorized": {"const": true},
        "luna_authorized": {"const": true},
        "sol_authorized": {"const": false},
        "formal_write_count": {"const": 0},
        "quick_intake_written": {"const": false},
        "scope": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^exactly_.+_listed_business_task_ids$"}
      }
    },
    "model_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "runtime_attestation"],
      "properties": {
        "model": {"const": "gpt-5.6-luna"},
        "reasoning_effort": {"const": "max"},
        "runtime_attestation": {"const": "requested_unverified"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_task_id", "capture_id", "formal_id", "absolute_path", "manifest_path", "manifest_sha256", "content_fingerprint", "task_kind", "blocking_missing_artifacts"],
      "properties": {
        "business_task_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "capture_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "formal_id": {"type": "string", "pattern": "^GS-[0-9]+$"},
        "absolute_path": {"type": "string", "pattern": "^/"},
        "manifest_path": {"type": "string", "pattern": "^/"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "task_kind": {"enum": ["independent_correct_no_false_wrong_card", "wrong_then_corrected_weakness_proposal"]},
        "blocking_missing_artifacts": {"type": "array", "maxItems": 0}
      }
    }
  }
}
