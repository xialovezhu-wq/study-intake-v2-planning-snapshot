    "reasoning_diagnosis": {"type": "object", "additionalProperties": false, "required": ["independent_correct_steps", "first_break", "later_breaks", "hint_dependencies", "self_corrections", "history_merge"], "properties": {"independent_correct_steps": {"$ref": "#/$defs/claims"}, "first_break": {"type": ["object", "null"], "additionalProperties": false, "required": ["claim_type", "text", "provenance", "evidence_refs", "confidence", "counterevidence_or_boundary", "sol_verification_action"], "properties": {"claim_type": {"type": "string", "enum": ["observed_fact", "evidence_bound_inference", "standard_math_candidate", "unresolved"]}, "text": {"type": "string", "minLength": 1, "maxLength": 4000}, "provenance": {"type": "string", "enum": ["capture", "formal_card", "source_bundle", "image", "model_inference", "mixed"]}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/evidence_ref"}}, "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "counterevidence_or_boundary": {"type": "string", "maxLength": 3000}, "sol_verification_action": {"type": "string", "minLength": 1, "maxLength": 3000}}}, "later_breaks": {"$ref": "#/$defs/claims"}, "hint_dependencies": {"$ref": "#/$defs/claims"}, "self_corrections": {"$ref": "#/$defs/claims"}, "history_merge": {"$ref": "#/$defs/claims"}}},
    "knowledge_error_signatures": {"type": "object", "additionalProperties": false, "required": ["primary_knowledge", "secondary_knowledge", "methods", "first_error", "later_errors", "historical_errors", "current_errors", "relationship_search_intents"], "properties": {"primary_knowledge": {"$ref": "#/$defs/claims"}, "secondary_knowledge": {"$ref": "#/$defs/claims"}, "methods": {"$ref": "#/$defs/claims"}, "first_error": {"type": ["object", "null"], "additionalProperties": false, "required": ["claim_type", "text", "provenance", "evidence_refs", "confidence", "counterevidence_or_boundary", "sol_verification_action"], "properties": {"claim_type": {"type": "string", "enum": ["observed_fact", "evidence_bound_inference", "standard_math_candidate", "unresolved"]}, "text": {"type": "string", "minLength": 1, "maxLength": 4000}, "provenance": {"type": "string", "enum": ["capture", "formal_card", "source_bundle", "image", "model_inference", "mixed"]}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/evidence_ref"}}, "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "counterevidence_or_boundary": {"type": "string", "maxLength": 3000}, "sol_verification_action": {"type": "string", "minLength": 1, "maxLength": 3000}}}, "later_errors": {"$ref": "#/$defs/claims"}, "historical_errors": {"$ref": "#/$defs/claims"}, "current_errors": {"$ref": "#/$defs/claims"}, "relationship_search_intents": {"$ref": "#/$defs/claims"}}},
    "concept_method_analysis": {"type": "object", "additionalProperties": false, "required": ["mechanisms", "method_triggers", "applicability_conditions", "boundary_conditions", "common_confusions", "transfer_risks"], "properties": {"mechanisms": {"$ref": "#/$defs/claims"}, "method_triggers": {"$ref": "#/$defs/claims"}, "applicability_conditions": {"$ref": "#/$defs/claims"}, "boundary_conditions": {"$ref": "#/$defs/claims"}, "common_confusions": {"$ref": "#/$defs/claims"}, "transfer_risks": {"$ref": "#/$defs/claims"}}},
    "formalization_candidates": {"type": "object", "additionalProperties": false, "required": ["safe_summary", "question_body", "source_and_answer", "independent_performance", "wrong_point", "error_causes", "methods", "traps", "method_gap", "wrong_history", "mastery_evidence", "relationship_proposals"], "properties": {"safe_summary": {"$ref": "#/$defs/claims"}, "question_body": {"$ref": "#/$defs/claims"}, "source_and_answer": {"$ref": "#/$defs/claims"}, "independent_performance": {"$ref": "#/$defs/claims"}, "wrong_point": {"$ref": "#/$defs/claims"}, "error_causes": {"$ref": "#/$defs/claims"}, "methods": {"$ref": "#/$defs/claims"}, "traps": {"$ref": "#/$defs/claims"}, "method_gap": {"$ref": "#/$defs/claims"}, "wrong_history": {"$ref": "#/$defs/claims"}, "mastery_evidence": {"$ref": "#/$defs/claims"}, "relationship_proposals": {"$ref": "#/$defs/claims"}}},
    "sol_verification_plan": {"type": "object", "additionalProperties": false, "required": ["must_verify", "reject_if", "source_checks", "identity_checks", "recommended_disposition"], "properties": {"must_verify": {"$ref": "#/$defs/claims"}, "reject_if": {"$ref": "#/$defs/claims"}, "source_checks": {"$ref": "#/$defs/claims"}, "identity_checks": {"$ref": "#/$defs/claims"}, "recommended_disposition": {"type": "string", "enum": ["new_candidate", "update_existing_candidate", "mastery_observation_candidate", "needs_user", "insufficient_evidence"]}}},
    "analysis": {
