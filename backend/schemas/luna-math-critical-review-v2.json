{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critical review of deep mathematics Luna analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "summary", "revised_analysis", "relationship_decisions", "unsupported_claims", "evidence_misreads", "mathematical_errors", "visual_findings", "provenance_findings", "missing_analysis", "required_corrections", "sol_priority_checks", "correction_resolutions"],
  "properties": {
    "schema_version": {"type": "string", "const": "study-intake-luna-math-critical-review-v2"},
    "verdict": {"type": "string", "enum": ["pass", "pass_with_warnings", "reject"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 3000},
    "revised_analysis": {"$ref": "#/$defs/analysis"},
    "relationship_decisions": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/relationship_decision"}},
    "unsupported_claims": {"$ref": "#/$defs/findings"},
    "evidence_misreads": {"$ref": "#/$defs/findings"},
    "mathematical_errors": {"$ref": "#/$defs/findings"},
    "visual_findings": {"$ref": "#/$defs/findings"},
    "provenance_findings": {"$ref": "#/$defs/findings"},
