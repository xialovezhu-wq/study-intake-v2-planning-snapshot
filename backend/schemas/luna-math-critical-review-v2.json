      "properties": {"schema_version": {"type": "string", "const": "study-intake-luna-math-analysis-v2"}, "report_profile": {"type": "string", "const": "math_deep"}, "executive_summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "target_identity": {"$ref": "#/$defs/target_identity"}, "question_structure": {"$ref": "#/$defs/question_structure"}, "correct_reasoning_reconstruction": {"$ref": "#/$defs/claims"}, "evidence_assessment": {"$ref": "#/$defs/evidence_assessment"}, "reasoning_diagnosis": {"$ref": "#/$defs/reasoning_diagnosis"}, "knowledge_error_signatures": {"$ref": "#/$defs/knowledge_error_signatures"}, "concept_method_analysis": {"$ref": "#/$defs/concept_method_analysis"}, "formalization_candidates": {"$ref": "#/$defs/formalization_candidates"}, "sol_verification_plan": {"$ref": "#/$defs/sol_verification_plan"}, "risk_flags": {"$ref": "#/$defs/claims"}, "unresolved": {"$ref": "#/$defs/claims"}, "atomic_signals": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/atomic_signal"}}}
