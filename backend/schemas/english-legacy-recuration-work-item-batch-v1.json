{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EN-P0-006 Luna recuration work item batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "remediation_gate",
    "authorization_expansion_closure_sha256",
    "batch_authorization_sha256",
    "inventory_sha256",
    "target_set_sha256",
    "authority",
    "target_count",
    "work_items",
    "model_call_count",
    "formal_write_count",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "english_legacy_recuration_work_item_batch_v1"},
    "remediation_gate": {"type": "object"},
    "authorization_expansion_closure_sha256": {"$ref": "#/$defs/sha256"},
    "batch_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "target_set_sha256": {"$ref": "#/$defs/sha256"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "authority_fingerprint"],
      "properties": {
        "generation": {"type": "string", "minLength": 1, "maxLength": 160},
        "authority_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "target_count": {"type": "integer", "minimum": 1},
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "target_id", "work_item_sha256", "work_item_path"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "target_id": {"type": "string", "minLength": 1, "maxLength": 240},
          "work_item_sha256": {"$ref": "#/$defs/sha256"},
          "work_item_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "model_call_count": {"const": 0},
    "formal_write_count": {"const": 0},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
