{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/subject-luna-batch-v1.json",
  "title": "Subject Luna Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "subject", "study_date", "status",
    "capture_high_watermark", "scan_snapshot_sha256", "authority_generation", "authority_fingerprint",
    "tasks", "exclusion_receipt_sha256s", "all_terminal", "sol_ready",
    "blocking_task_ids", "formal_write_count", "revision", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "subject_luna_batch_v1"},
    "batch_id": {"type": "string", "minLength": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "study_date": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "frozen"]},
    "capture_high_watermark": {"type": "string", "minLength": 1},
    "scan_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "authority_generation": {"type": "string", "minLength": 1},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    },
    "exclusion_receipt_sha256s": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "all_terminal": {"type": "boolean"},
    "sol_ready": {"type": "boolean"},
    "blocking_task_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "formal_write_count": {"const": 0},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id", "unit_sha256", "input_fingerprint", "study_date", "frozen_payload_sha256", "status",
        "proposal_sha256", "package_sha256", "quality_receipt_sha256",
        "terminal_receipt_sha256", "error_code"
      ],
      "properties": {
        "capture_id": {"type": "string", "minLength": 1},
        "unit_sha256": {"$ref": "#/$defs/sha256"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "study_date": {"type": "string", "minLength": 1},
        "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
        "status": {
          "enum": [
            "selected", "queued", "claimed", "analysis_running", "critical_review_running",
            "retrying", "quality_pending", "quality_passed", "needs_rework",
            "failed", "evidence_pending"
          ]
        },
        "proposal_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "package_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "quality_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "terminal_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "error_code": {"type": ["string", "null"]}
      }
    }
  }
}
