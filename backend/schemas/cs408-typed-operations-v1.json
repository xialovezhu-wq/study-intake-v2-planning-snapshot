{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cs408-typed-operations-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "capture_id",
    "verdict",
    "analysis_output_sha256",
    "critical_review_output_sha256",
    "stage_allowed_evidence_refs",
    "operations",
    "formal_write_count"
  ],
  "properties": {
    "schema_version": {"const": "cs408-typed-operations-v1"},
    "subject": {"const": "cs408"},
    "capture_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "verdict": {"enum": ["pass", "pass_with_warnings", "reject"]},
    "analysis_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "critical_review_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage_allowed_evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis", "critical_review"],
      "properties": {
        "analysis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^mcp-item:cs408:[0-9a-f]{64}$"}},
        "critical_review": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^mcp-item:cs408:[0-9a-f]{64}$"}}
      }
    },
    "operations": {"type": "array"},
    "formal_write_count": {"const": 0}
  }
}
