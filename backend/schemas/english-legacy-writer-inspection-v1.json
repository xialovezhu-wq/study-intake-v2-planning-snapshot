{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/english-legacy-writer-inspection-v1.json",
  "title": "English Legacy Writer Inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mode", "batch_id", "target_id", "target_kind",
    "ordinal", "review_receipt_sha256", "decision", "outcome",
    "pre_object_sha256", "post_object_sha256",
    "writer_process_evidence_sha256", "transaction_evidence_sha256",
    "formal_write_count", "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "english_legacy_writer_inspection_v1"},
    "mode": {"enum": ["dry_run", "apply"]},
    "batch_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "target_kind": {
      "enum": ["master_bank_row", "sentence_pattern_card", "article_learning_page"]
    },
    "ordinal": {"type": "integer", "minimum": 1},
    "review_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "decision": {"enum": ["update_existing", "already_current", "reject"]},
    "outcome": {
      "enum": ["planned_update", "already_current", "committed", "reject", "runtime_failure"]
    },
    "pre_object_sha256": {"$ref": "#/$defs/sha256"},
    "post_object_sha256": {"$ref": "#/$defs/sha256"},
    "writer_process_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "transaction_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "formal_write_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "completed_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
