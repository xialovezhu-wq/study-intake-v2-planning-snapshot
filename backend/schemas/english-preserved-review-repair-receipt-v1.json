{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-english-preserved-review-repair-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repair_id", "authorization_descriptor_sha256", "subject", "mode",
    "source_release_id", "source_activation_id", "target_release_id", "target_activation_id",
    "target_generation", "target_subject_authority_fingerprint",
    "target_producer_authority_fingerprint", "capture_id", "unit_sha256",
    "frozen_payload_sha256", "producer_input_contract_sha256", "evidence_bindings",
    "mutable_preimages", "batch_archive_sha256", "batch_archive_path",
    "batch_retirement_pointer_sha256", "preimage_capsule_sha256", "preimage_capsule_path",
    "batch_postimage_sha256", "batch_pointer_postimage_sha256", "writer_postimage_sha256",
    "review_artifacts", "review_terminal_sha256", "review_terminal_path", "source_queue_path",
    "source_queue_absent", "target_queue_path", "queue_postimage_sha256",
    "queue_identity_preserved", "source_gate_preimage_sha256", "staged_gate_preimage_sha256",
    "gate_postimage_sha256", "terminal_index_postimage_sha256",
    "terminal_index_postimage_path", "report_available",
    "report_disposition", "sol_review_status", "formal_write_eligible",
    "historical_terminal_receipt_sha256", "new_task_count", "new_queue_count",
    "capture_replay_count", "model_call_count", "provider_request_count", "mcp_tool_call_count",
    "sol_call_count", "formal_write_count", "created_at", "authority"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-english-preserved-review-repair-receipt-v1"},
    "repair_id": {"$ref": "#/$defs/sha256"},
    "authorization_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "subject": {"const": "english"},
    "mode": {"const": "same_queue_review_reclassification_zero_external_calls"},
    "source_release_id": {"$ref": "#/$defs/sha256"},
    "source_activation_id": {"$ref": "#/$defs/sha256"},
    "target_release_id": {"$ref": "#/$defs/sha256"},
    "target_activation_id": {"$ref": "#/$defs/sha256"},
    "target_generation": {"type": "string", "minLength": 1},
    "target_subject_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "target_producer_authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "capture_id": {"type": "string", "minLength": 1},
    "unit_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
    "producer_input_contract_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_bindings": {"$ref": "#/$defs/evidence_bindings"},
    "mutable_preimages": {"$ref": "#/$defs/mutable_preimages"},
    "batch_archive_sha256": {"$ref": "#/$defs/sha256"},
    "batch_archive_path": {"$ref": "#/$defs/absolute_path"},
    "batch_retirement_pointer_sha256": {"$ref": "#/$defs/sha256"},
    "preimage_capsule_sha256": {"$ref": "#/$defs/sha256"},
    "preimage_capsule_path": {"$ref": "#/$defs/absolute_path"},
    "batch_postimage_sha256": {"$ref": "#/$defs/sha256"},
    "batch_pointer_postimage_sha256": {"$ref": "#/$defs/sha256"},
    "writer_postimage_sha256": {"$ref": "#/$defs/sha256"},
    "review_artifacts": {"$ref": "#/$defs/review_artifacts"},
    "review_terminal_sha256": {"$ref": "#/$defs/sha256"},
    "review_terminal_path": {"$ref": "#/$defs/absolute_path"},
    "source_queue_path": {"$ref": "#/$defs/absolute_path"},
    "source_queue_absent": {"const": true},
    "target_queue_path": {"$ref": "#/$defs/absolute_path"},
    "queue_postimage_sha256": {"$ref": "#/$defs/sha256"},
    "queue_identity_preserved": {"const": true},
    "source_gate_preimage_sha256": {"$ref": "#/$defs/sha256"},
    "staged_gate_preimage_sha256": {"$ref": "#/$defs/sha256"},
    "gate_postimage_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_index_postimage_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_index_postimage_path": {"$ref": "#/$defs/absolute_path"},
    "report_available": {"const": true},
    "report_disposition": {"enum": ["needs_sol_review", "quarantined"]},
    "sol_review_status": {"const": "pending"},
    "formal_write_eligible": {"const": false},
    "historical_terminal_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "new_task_count": {"const": 0}, "new_queue_count": {"const": 0},
    "capture_replay_count": {"const": 0}, "model_call_count": {"const": 0},
    "provider_request_count": {"const": 0}, "mcp_tool_call_count": {"const": 0},
    "sol_call_count": {"const": 0}, "formal_write_count": {"const": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/", "minLength": 2},
    "evidence_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["original_preclaim_failure_receipt_sha256", "rollover_receipt_sha256",
        "recovery_supersede_receipt_sha256", "task_object_sha256", "raw_output_object_sha256",
        "mcp_transport_sha256", "duplicate_result_projection_sha256", "stage_execution_receipt_sha256", "processing_receipt_sha256",
        "mcp_failure_receipt_sha256", "canary_terminal_receipt_sha256", "subject_terminal_receipt_sha256"],
      "properties": {
        "original_preclaim_failure_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "rollover_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_supersede_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "task_object_sha256": {"$ref": "#/$defs/sha256"},
        "raw_output_object_sha256": {"$ref": "#/$defs/sha256"},
        "mcp_transport_sha256": {"$ref": "#/$defs/sha256"},
        "duplicate_result_projection_sha256": {"$ref": "#/$defs/sha256"},
        "stage_execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "processing_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "mcp_failure_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "canary_terminal_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "subject_terminal_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mutable_preimages": {
      "type": "object", "additionalProperties": false,
      "required": ["queue_preimage_sha256", "gate_preimage_sha256", "terminal_index_preimage_sha256",
        "subject_batch_preimage_sha256", "subject_batch_pointer_preimage_sha256",
        "subject_writer_preimage_sha256", "staged_gate_preimage_sha256",
        "staged_terminal_index_preimage_sha256"],
      "properties": {
        "queue_preimage_sha256": {"$ref": "#/$defs/sha256"},
        "gate_preimage_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_index_preimage_sha256": {"$ref": "#/$defs/sha256"},
        "subject_batch_preimage_sha256": {"$ref": "#/$defs/sha256"},
        "subject_batch_pointer_preimage_sha256": {"$ref": "#/$defs/sha256"},
        "subject_writer_preimage_sha256": {"$ref": "#/$defs/sha256"},
        "staged_gate_preimage_sha256": {"$ref": "#/$defs/sha256"},
        "staged_terminal_index_preimage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["package_sha256", "package_path", "report_json_sha256", "report_json_path",
        "report_markdown_sha256", "report_markdown_path", "mcp_transcript_sha256",
        "mcp_transcript_path", "normalization_receipt_sha256", "normalization_receipt_path"],
      "properties": {
        "package_sha256": {"$ref": "#/$defs/sha256"}, "package_path": {"$ref": "#/$defs/absolute_path"},
        "report_json_sha256": {"$ref": "#/$defs/sha256"}, "report_json_path": {"$ref": "#/$defs/absolute_path"},
        "report_markdown_sha256": {"$ref": "#/$defs/sha256"}, "report_markdown_path": {"$ref": "#/$defs/absolute_path"},
        "mcp_transcript_sha256": {"$ref": "#/$defs/sha256"}, "mcp_transcript_path": {"$ref": "#/$defs/absolute_path"},
        "normalization_receipt_sha256": {"$ref": "#/$defs/sha256"}, "normalization_receipt_path": {"$ref": "#/$defs/absolute_path"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"}, "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-english-preserved-review-repair-v1"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
