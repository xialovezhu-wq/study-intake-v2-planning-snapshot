{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiazhibin.local/schemas/stage-terminal-relock-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_only", "stage", "outcome", "authorization_receipt_sha256", "remaining_tasks", "relocked", "formal_write_count", "completed_at", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "study-intake-stage-terminal-relock-v1"},
    "fixture_only": {"type": "boolean"},
    "stage": {"enum": ["terra", "luna"]},
    "outcome": {"enum": ["succeeded", "failed", "cancelled", "timed_out"]},
    "authorization_receipt_sha256": {"$ref": "#/$defs/sha"},
    "remaining_tasks": {"const": 0},
    "relocked": {"const": true},
    "formal_write_count": {"const": 0},
    "completed_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
