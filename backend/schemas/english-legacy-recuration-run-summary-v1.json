{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EN-P0-006 Luna recuration run summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_item_batch_sha256",
    "authorization_expansion_closure_sha256", "batch_authorization_sha256",
    "inventory_sha256", "target_set_sha256", "attempt", "batch_target_count",
    "selected_ordinals", "selected_count", "results", "succeeded_count",
    "deduplicated_count", "failed_count", "status", "concurrency_attestation",
    "runtime_identity_status", "model_call_count", "formal_write_count",
    "started_at", "completed_at", "hmac_key_id", "hmac_sha256"
  ],
  "properties": {
    "schema_version": {"const": "english_legacy_recuration_run_summary_v1"},
    "work_item_batch_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_expansion_closure_sha256": {"$ref": "#/$defs/sha256"},
    "batch_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "target_set_sha256": {"$ref": "#/$defs/sha256"},
    "attempt": {"type": "integer", "minimum": 1},
    "batch_target_count": {"type": "integer", "minimum": 1},
    "selected_ordinals": {
      "type": "array", "minItems": 1, "maxItems": 98, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "selected_count": {"enum": [1, 10, 98]},
    "results": {
      "type": "array", "minItems": 1, "maxItems": 98,
      "items": {"$ref": "#/$defs/result"}
    },
    "succeeded_count": {"type": "integer", "minimum": 0},
    "deduplicated_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "status": {"enum": ["passed", "failed_closed"]},
    "concurrency_attestation": {"$ref": "#/$defs/concurrency_attestation"},
    "runtime_identity_status": {"const": "requested_unverified"},
    "model_call_count": {"type": "integer", "minimum": 0, "maximum": 196},
    "formal_write_count": {"const": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "hmac_key_id": {"$ref": "#/$defs/sha256"},
    "hmac_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "nullable_timestamp": {
      "anyOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "target_id", "status", "error_code", "package_sha256",
        "quality_receipt_sha256", "failure_receipt_sha256",
        "model_call_count", "formal_write_count"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "status": {"enum": ["succeeded", "deduplicated", "failed"]},
        "error_code": {
          "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "package_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "quality_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "failure_receipt_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "model_call_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "formal_write_count": {"const": 0}
      }
    },
    "stage_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "observed_at"],
      "properties": {
        "name": {
          "enum": [
            "analysis_submitted", "analysis_completed",
            "critical_review_submitted", "critical_review_completed"
          ]
        },
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "item_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "target_id", "barrier_arrived_at", "submitted_at", "stage_events",
        "strict_stage_order_verified", "exact_two_calls_verified"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "barrier_arrived_at": {"$ref": "#/$defs/nullable_timestamp"},
        "submitted_at": {"$ref": "#/$defs/nullable_timestamp"},
        "stage_events": {
          "type": "array", "maxItems": 4,
          "items": {"$ref": "#/$defs/stage_event"}
        },
        "strict_stage_order_verified": {"type": "boolean"},
        "exact_two_calls_verified": {"type": "boolean"}
      }
    },
    "smoke_prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke_1_summary_sha256", "smoke_10_summary_sha256"],
      "properties": {
        "smoke_1_summary_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "smoke_10_summary_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "concurrency_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_mode", "max_workers", "barrier_timeout_seconds",
        "barrier_expected", "barrier_arrived", "barrier_released_at",
        "submitted_at_first", "submitted_at_last", "submitted_at_spread_ms",
        "peak_active", "item_traces", "strict_stage_order_count",
        "exact_two_call_count", "smoke_prerequisites", "gate_status",
        "failure_code"
      ],
      "properties": {
        "schema_version": {
          "const": "english_legacy_recuration_concurrency_attestation_v1"
        },
        "run_mode": {"enum": ["smoke_1", "smoke_10", "full_98"]},
        "max_workers": {"enum": [1, 10, 98]},
        "barrier_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "barrier_expected": {"enum": [1, 10, 98]},
        "barrier_arrived": {"type": "integer", "minimum": 0, "maximum": 98},
        "barrier_released_at": {"$ref": "#/$defs/nullable_timestamp"},
        "submitted_at_first": {"$ref": "#/$defs/nullable_timestamp"},
        "submitted_at_last": {"$ref": "#/$defs/nullable_timestamp"},
        "submitted_at_spread_ms": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "peak_active": {"type": "integer", "minimum": 0, "maximum": 98},
        "item_traces": {
          "type": "array", "minItems": 1, "maxItems": 98,
          "items": {"$ref": "#/$defs/item_trace"}
        },
        "strict_stage_order_count": {
          "type": "integer", "minimum": 0, "maximum": 98
        },
        "exact_two_call_count": {
          "type": "integer", "minimum": 0, "maximum": 98
        },
        "smoke_prerequisites": {"$ref": "#/$defs/smoke_prerequisites"},
        "gate_status": {"enum": ["passed", "failed_closed"]},
        "failure_code": {
          "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        }
      }
    }
  }
}
