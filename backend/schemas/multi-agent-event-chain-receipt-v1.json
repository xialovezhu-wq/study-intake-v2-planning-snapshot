{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/multi-agent-event-chain-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parent_agent_id", "child_agent_ids", "branch_ids", "event_count", "ordered_event_sha256s", "formal_write_count", "event_chain_sha256"],
  "properties": {
    "schema_version": {"const": "multi_agent_event_chain_receipt_v1"},
    "parent_agent_id": {"type": "string", "minLength": 1},
    "child_agent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "branch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "event_count": {"type": "integer", "minimum": 1},
    "ordered_event_sha256s": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "formal_write_count": {"const": 0},
    "event_chain_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
