{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/sol-review-receipt-v1.json",
  "title": "Sol Review Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "subject", "fencing_token", "writer",
    "writer_adapter", "canonical_evidence_sha256", "decisions", "status",
    "dispatcher_effect", "formal_write_count", "completed_at", "seal"
  ],
  "properties": {
    "schema_version": {"const": "sol_review_receipt_v1"},
    "batch_id": {"type": "string", "minLength": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "fencing_token": {"type": "integer", "minimum": 1},
    "writer": {"const": "sol"},
    "writer_adapter": {
      "enum": [
        "math_nightly_writer_v1", "cs408_daily_intake_writer_v1",
        "english_daily_intake_writer_v1"
      ]
    },
    "canonical_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/decision"}
    },
    "status": {"enum": ["approved", "needs_user", "rejected", "failed"]},
    "dispatcher_effect": {"$ref": "#/$defs/dispatcher_effect"},
    "formal_write_count": {"const": 0},
    "completed_at": {"type": "string", "minLength": 1},
    "seal": {"$ref": "#/$defs/seal"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_sha256", "decision", "modified_proposal_sha256", "reason"],
      "properties": {
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "decision": {"enum": ["adopt", "modify", "reject"]},
        "modified_proposal_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "dispatcher_effect": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "subject", "paused_subjects", "drained_subjects", "other_subjects_unchanged"],
      "properties": {
        "scope": {"const": "subject"},
        "subject": {"enum": ["math", "cs408", "english"]},
        "paused_subjects": {"const": []},
        "drained_subjects": {"const": []},
        "other_subjects_unchanged": {"const": true}
      }
    },
    "seal": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "purpose", "hmac_sha256"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "purpose": {"const": "writer-adapter-sol-review-receipt"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
