{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://local.invalid/study-intake/read-bundle-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_sha256", "subject", "capture_id", "frozen_task_sha256", "release_id", "activation_id", "authority_snapshot_sha256", "generation", "ordered_branch_results", "successful_branch_ids", "failed_branch_ids", "missing_branch_ids", "required_failure_branch_ids", "evidence_index", "evidence_membership", "deduplicated_evidence_count", "conflict_index", "technical_integrity_errors", "coverage_complete", "fanout_telemetry", "formal_write_count", "read_bundle_sha256"],
  "properties": {
    "schema_version": {"const": "read_bundle_v1"}, "plan_id": {"type": "string", "minLength": 1}, "plan_sha256": {"$ref": "#/$defs/sha"},
    "subject": {"enum": ["math", "cs408", "english"]}, "capture_id": {"type": "string", "minLength": 1}, "frozen_task_sha256": {"$ref": "#/$defs/sha"}, "release_id": {"$ref": "#/$defs/sha"}, "activation_id": {"$ref": "#/$defs/sha"}, "authority_snapshot_sha256": {"$ref": "#/$defs/sha"}, "generation": {"type": "string", "minLength": 1},
    "ordered_branch_results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["branch_id", "result_sha256"], "properties": {"branch_id": {"type": "string"}, "result_sha256": {"$ref": "#/$defs/sha"}}}},
    "successful_branch_ids": {"$ref": "#/$defs/ids"}, "failed_branch_ids": {"$ref": "#/$defs/ids"}, "missing_branch_ids": {"$ref": "#/$defs/ids"}, "required_failure_branch_ids": {"$ref": "#/$defs/ids"},
    "evidence_index": {"type": "object"}, "evidence_membership": {"type": "object"}, "deduplicated_evidence_count": {"type": "integer", "minimum": 0}, "conflict_index": {"type": "array"}, "technical_integrity_errors": {"$ref": "#/$defs/ids"},
    "coverage_complete": {"type": "boolean"}, "fanout_telemetry": {"type": "object"},
    "formal_write_count": {"const": 0}, "read_bundle_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
