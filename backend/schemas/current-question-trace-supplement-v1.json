{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content-addressed current-question trace supplement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capture_id", "context_id", "item_id",
    "evidence_manifest_sha256", "created_at", "events", "supplement_kind",
    "resolution_receipt_sha256", "interaction_trace_sha256", "formal_write_count"
  ],
  "properties": {
    "schema_version": {"const": "current-question-trace-supplement-v1"},
    "capture_id": {"type": "string", "minLength": 2, "maxLength": 256},
    "context_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "item_id": {"type": ["string", "null"], "maxLength": 256},
    "evidence_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "kind", "text", "observed_at"],
        "properties": {
          "role": {"type": "string", "enum": ["learner", "assistant"]},
          "kind": {"type": "string", "enum": ["utterance", "first_action", "reasoning", "hint", "correction", "restatement", "answer"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 12000},
          "observed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "supplement_kind": {"type": "string", "enum": ["legacy_backfill", "resolved_trace"]},
    "resolution_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "interaction_trace_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "formal_write_count": {"const": 0}
  }
}
