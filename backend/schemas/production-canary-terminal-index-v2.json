{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "study-intake-production-canary-terminal-index-v2",
  "type": "object",
  "required": [
    "activation_id",
    "authority",
    "counter_scope",
    "formal_write_count",
    "model_call_count",
    "provider_request_count",
    "release_id",
    "schema_version",
    "sol_enabled",
    "subject",
    "terminal_by_outcome",
    "terminal_task_count",
    "units",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "study-intake-production-canary-terminal-index-v2"
    },
    "subject": {
      "enum": ["math", "cs408", "english"]
    },
    "release_id": {
      "$ref": "#/$defs/sha256"
    },
    "activation_id": {
      "$ref": "#/$defs/sha256"
    },
    "terminal_task_count": {
      "type": "integer",
      "minimum": 0
    },
    "terminal_by_outcome": {
      "type": "object",
      "required": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "needs_rework"
      ],
      "properties": {
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0},
        "timed_out": {"type": "integer", "minimum": 0},
        "needs_rework": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/terminalUnit"
      }
    },
    "counter_scope": {
      "const": "current_activation_latest_terminal_per_unit"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "model_call_count": {
      "const": 0
    },
    "provider_request_count": {
      "const": 0
    },
    "formal_write_count": {
      "const": 0
    },
    "sol_enabled": {
      "const": false
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40
    },
    "processStartToken": {
      "type": "string",
      "pattern": "^darwin-libproc-bsdinfo-v1:[1-9][0-9]*:[1-9][0-9]*:[0-9]{6}$"
    },
    "historyEntry": {
      "type": "object",
      "required": [
        "terminal_receipt_sha256",
        "terminal_receipt_path",
        "outcome",
        "error_code",
        "terminal_kind",
        "finished_at",
        "prior_terminal_receipt_sha256"
      ],
      "properties": {
        "terminal_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_receipt_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "timed_out",
            "needs_rework"
          ]
        },
        "error_code": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "terminal_kind": {
          "enum": [
            "normal",
            "emergency_hard_cancel",
            "fail_closed_recovery",
            "post_terminal_projection_failure"
          ]
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "prior_terminal_receipt_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "runnerInterval": {
      "type": "object",
      "required": [
        "task_process_identity_sha256",
        "task_process_exit_sha256",
        "pid",
        "pgid",
        "process_start_token",
        "started_at",
        "finished_at",
        "reaped"
      ],
      "properties": {
        "task_process_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_process_exit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pid": {
          "type": "integer",
          "minimum": 2
        },
        "pgid": {
          "type": "integer",
          "minimum": 2
        },
        "process_start_token": {
          "$ref": "#/$defs/processStartToken"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reaped": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "terminalUnit": {
      "type": "object",
      "required": [
        "admitted_at",
        "error_code",
        "finished_at",
        "frozen_payload_sha256",
        "history",
        "outcome",
        "package_ref",
        "package_sha256",
        "producer_unit_id",
        "report_json_ref",
        "report_json_sha256",
        "report_markdown_ref",
        "report_markdown_sha256",
        "report_reopen_status",
        "runner_evidenced",
        "runner_interval",
        "terminal_kind",
        "terminal_receipt_path",
        "terminal_receipt_sha256",
        "unit_sha256"
      ],
      "properties": {
        "unit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "frozen_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "admitted_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "timed_out",
            "needs_rework"
          ]
        },
        "error_code": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "terminal_kind": {
          "enum": [
            "normal",
            "emergency_hard_cancel",
            "fail_closed_recovery",
            "post_terminal_projection_failure"
          ]
        },
        "terminal_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_receipt_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "package_ref": {
          "type": ["string", "null"],
          "pattern": "^study-intake-dispatch-package://sha256/[0-9a-f]{64}$"
        },
        "package_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_json_ref": {
          "type": ["string", "null"],
          "pattern": "^study-intake-report://sha256/[0-9a-f]{64}$"
        },
        "report_json_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_markdown_ref": {
          "type": ["string", "null"],
          "pattern": "^study-intake-report-markdown://sha256/[0-9a-f]{64}$"
        },
        "report_markdown_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_reopen_status": {
          "enum": ["not_available", "json_markdown_package_verified"]
        },
        "runner_evidenced": {
          "type": "boolean"
        },
        "runner_interval": {
          "oneOf": [
            {"$ref": "#/$defs/runnerInterval"},
            {"type": "null"}
          ]
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/historyEntry"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {"const": "succeeded"}
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "error_code": {"const": null},
              "package_ref": {"type": "string"},
              "package_sha256": {"type": "string"},
              "report_json_ref": {"type": "string"},
              "report_json_sha256": {"type": "string"},
              "report_markdown_ref": {"type": "string"},
              "report_markdown_sha256": {"type": "string"},
              "report_reopen_status": {
                "const": "json_markdown_package_verified"
              },
              "runner_evidenced": {"const": true},
              "runner_interval": {
                "$ref": "#/$defs/runnerInterval"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "report_reopen_status": {"const": "not_available"}
            },
            "required": ["report_reopen_status"]
          },
          "then": {
            "properties": {
              "package_ref": {"const": null},
              "package_sha256": {"const": null},
              "report_json_ref": {"const": null},
              "report_json_sha256": {"const": null},
              "report_markdown_ref": {"const": null},
              "report_markdown_sha256": {"const": null}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "schema_version",
        "algorithm",
        "key_id",
        "purpose",
        "hmac_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "study-intake-dispatch-authority-v1"
        },
        "algorithm": {
          "const": "HMAC-SHA256"
        },
        "key_id": {
          "$ref": "#/$defs/sha256"
        },
        "purpose": {
          "const": "dispatch-production-canary-terminal-index"
        },
        "hmac_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
