{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiazhibin.local/schemas/sol-mcp-preflight-terminal-v1.json",
  "title": "Sol MCP preflight terminal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "preflight_session_id",
    "subject",
    "central_release_id",
    "mcp_release_id",
    "launcher_sha256",
    "tool_policy_sha256",
    "session_manifest_sha256",
    "protocol_transcript_sha256",
    "stderr_sha256",
    "pid",
    "pgid",
    "start_token",
    "initialize",
    "tools_list",
    "read_allowlist",
    "minimal_read",
    "result_schema",
    "subject_scope",
    "cursor_test",
    "process_cleanup",
    "receipt_reopen",
    "status",
    "read_call_count",
    "write_call_count",
    "model_call_count",
    "provider_request_count",
    "live_capture_created_count",
    "live_capture_consumed_count",
    "formal_write_count",
    "started_at",
    "completed_at",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "sol-mcp-preflight-terminal-v1"},
    "purpose": {"const": "infrastructure_preflight"},
    "preflight_session_id": {"type": "string"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "central_release_id": {"$ref": "#/$defs/sha"},
    "mcp_release_id": {"$ref": "#/$defs/sha"},
    "launcher_sha256": {"$ref": "#/$defs/sha"},
    "tool_policy_sha256": {"$ref": "#/$defs/sha"},
    "session_manifest_sha256": {"$ref": "#/$defs/sha"},
    "protocol_transcript_sha256": {"$ref": "#/$defs/sha"},
    "stderr_sha256": {"$ref": "#/$defs/sha"},
    "pid": {"type": "integer", "minimum": 1},
    "pgid": {"type": "integer", "minimum": 1},
    "start_token": {"type": "string", "minLength": 1},
    "initialize": {"const": "passed"},
    "tools_list": {"const": "passed"},
    "read_allowlist": {"const": "passed"},
    "minimal_read": {"const": "passed"},
    "result_schema": {"const": "passed"},
    "subject_scope": {"const": "passed"},
    "cursor_test": {"enum": ["passed", "not_applicable"]},
    "process_cleanup": {"const": "passed"},
    "receipt_reopen": {"const": "passed"},
    "status": {"enum": ["passed", "failed"]},
    "read_call_count": {"type": "integer", "minimum": 1},
    "write_call_count": {"const": 0},
    "model_call_count": {"const": 0},
    "provider_request_count": {"const": 0},
    "live_capture_created_count": {"const": 0},
    "live_capture_consumed_count": {"const": 0},
    "formal_write_count": {"const": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
