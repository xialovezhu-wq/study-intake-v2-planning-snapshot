{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subject-bound immutable MCP read session v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "read_session_id", "subject", "candidate_release_id", "plugin_version", "skill_id", "skill_version", "mcp_server_release", "generation", "authority_fingerprint", "created_at", "formal_write_count", "capture_id", "capture_manifest_path", "capture_manifest_sha256", "artifact_ids", "authority_snapshot_manifest_path", "authority_snapshot_manifest_sha256", "authority_snapshot_root", "authority_snapshot_receipt_sha256", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "study-read-mcp-read-session.v4"},
    "read_session_id": {"type": "string", "pattern": "^MCPRS-[A-Z0-9-]{16,80}$"},
    "subject": {"enum": ["math", "cs408", "english"]},
    "candidate_release_id": {"$ref": "#/$defs/sha256"},
    "plugin_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "skill_id": {"enum": ["background-math-processing", "background-cs408-processing", "background-english-processing"]},
    "skill_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "mcp_server_release": {"type": "string", "pattern": "^0\\.4\\.1\\+sha256\\.[0-9a-f]{64}$"},
    "generation": {"type": "string", "minLength": 1, "maxLength": 160},
    "authority_fingerprint": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "formal_write_count": {"const": 0},
    "capture_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "capture_manifest_path": {"type": "string", "pattern": "^/"},
    "capture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"}},
    "authority_snapshot_manifest_path": {"type": "string", "pattern": "^/"},
    "authority_snapshot_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "authority_snapshot_root": {"type": "string", "pattern": "^/"},
    "authority_snapshot_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"subject": {"const": "math"}}}, "then": {"properties": {"skill_id": {"const": "background-math-processing"}}}},
    {"if": {"properties": {"subject": {"const": "cs408"}}}, "then": {"properties": {"skill_id": {"const": "background-cs408-processing"}}}},
    {"if": {"properties": {"subject": {"const": "english"}}}, "then": {"properties": {"skill_id": {"const": "background-english-processing"}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
