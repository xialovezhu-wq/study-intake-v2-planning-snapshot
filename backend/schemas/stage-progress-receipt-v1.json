{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/stage-progress-receipt-v1.json",
  "title": "Study Intake stage progress receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sequence", "unit_sha256", "owner_id", "lease_fence",
    "attempt", "subject", "capture_id", "release_id", "frozen_payload_sha256",
    "stage_name", "provider_stage_name", "progress_kind", "occurred_at", "provider_pid", "provider_pgid",
    "process_start_token", "stdout_bytes", "stderr_bytes", "mcp_tool_call_count",
    "provider_process_identity_sha256", "artifact_sha256",
    "previous_progress_receipt_sha256", "formal_write_count", "authority"
  ],
  "properties": {
    "schema_version": {"const": "study-intake-stage-progress-receipt-v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "unit_sha256": {"$ref": "#/$defs/sha256"},
    "owner_id": {"$ref": "#/$defs/safeId"},
    "lease_fence": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "capture_id": {"$ref": "#/$defs/safeId"},
    "release_id": {"$ref": "#/$defs/sha256"},
    "frozen_payload_sha256": {"$ref": "#/$defs/sha256"},
    "stage_name": {"$ref": "#/$defs/stage"},
    "provider_stage_name": {"$ref": "#/$defs/providerStage"},
    "progress_kind": {"enum": ["stage_transition", "provider_output", "provider_event", "provider_liveness", "mcp_call", "raw_output_persisted", "normalization_completed", "provider_exit"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "provider_pid": {"type": ["integer", "null"], "minimum": 1},
    "provider_pgid": {"type": ["integer", "null"], "minimum": 1},
    "process_start_token": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "provider_process_identity_sha256": {"$ref": "#/$defs/nullableSha256"},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "mcp_tool_call_count": {"type": "integer", "minimum": 0},
    "artifact_sha256": {"$ref": "#/$defs/nullableSha256"},
    "previous_progress_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
    "formal_write_count": {"const": 0},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
      "then": {"properties": {"previous_progress_receipt_sha256": {"const": null}}},
      "else": {"properties": {"previous_progress_receipt_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {"properties": {"progress_kind": {"enum": ["provider_output", "provider_event", "provider_liveness", "mcp_call", "raw_output_persisted", "normalization_completed", "provider_exit"]}}, "required": ["progress_kind"]},
      "then": {"properties": {"provider_process_identity_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {"$ref": "#/$defs/topStageBinding"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "stage": {"enum": ["analysis", "critical_review"]},
    "providerStage": {"enum": ["math_analysis", "math_critical_review", "cs408_analysis", "cs408_critical_review", "english_analysis", "english_critical_review"]},
    "topStageBinding": {
      "allOf": [
        {"if": {"properties": {"subject": {"const": "math"}}, "required": ["subject"]}, "then": {"properties": {"provider_stage_name": {"enum": ["math_analysis", "math_critical_review"]}}}},
        {"if": {"properties": {"subject": {"const": "cs408"}}, "required": ["subject"]}, "then": {"properties": {"provider_stage_name": {"enum": ["cs408_analysis", "cs408_critical_review"]}}}},
        {"if": {"properties": {"subject": {"const": "english"}}, "required": ["subject"]}, "then": {"properties": {"provider_stage_name": {"enum": ["english_analysis", "english_critical_review"]}}}},
        {"if": {"properties": {"stage_name": {"const": "analysis"}}, "required": ["stage_name"]}, "then": {"properties": {"provider_stage_name": {"enum": ["math_analysis", "cs408_analysis", "english_analysis"]}}}},
        {"if": {"properties": {"stage_name": {"const": "critical_review"}}, "required": ["stage_name"]}, "then": {"properties": {"provider_stage_name": {"enum": ["math_critical_review", "cs408_critical_review", "english_critical_review"]}}}},
        {"if": {"properties": {"provider_stage_name": {"const": "math_analysis"}}, "required": ["provider_stage_name"]}, "then": {"properties": {"subject": {"const": "math"}, "stage_name": {"const": "analysis"}}}},
        {"if": {"properties": {"provider_stage_name": {"const": "math_critical_review"}}, "required": ["provider_stage_name"]}, "then": {"properties": {"subject": {"const": "math"}, "stage_name": {"const": "critical_review"}}}},
        {"if": {"properties": {"provider_stage_name": {"const": "cs408_analysis"}}, "required": ["provider_stage_name"]}, "then": {"properties": {"subject": {"const": "cs408"}, "stage_name": {"const": "analysis"}}}},
        {"if": {"properties": {"provider_stage_name": {"const": "cs408_critical_review"}}, "required": ["provider_stage_name"]}, "then": {"properties": {"subject": {"const": "cs408"}, "stage_name": {"const": "critical_review"}}}},
        {"if": {"properties": {"provider_stage_name": {"const": "english_analysis"}}, "required": ["provider_stage_name"]}, "then": {"properties": {"subject": {"const": "english"}, "stage_name": {"const": "analysis"}}}},
        {"if": {"properties": {"provider_stage_name": {"const": "english_critical_review"}}, "required": ["provider_stage_name"]}, "then": {"properties": {"subject": {"const": "english"}, "stage_name": {"const": "critical_review"}}}}
      ]
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "algorithm", "key_id", "purpose", "hmac_sha256"],
      "properties": {
        "schema_version": {"const": "study-intake-dispatch-authority-v1"},
        "algorithm": {"const": "HMAC-SHA256"}, "key_id": {"$ref": "#/$defs/sha256"},
        "purpose": {"const": "dispatch-stage-progress"}, "hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
