{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study intake dashboard projection",
  "type": "object",
  "required": ["schema_version", "generated_at", "study_date", "worker", "subjects"],
  "properties": {
    "schema_version": {"const": "study-intake-dashboard-projection-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "study_date": {"type": "string", "format": "date"},
    "worker": {"type": "object"},
    "subjects": {
      "type": "object",
      "required": ["math", "cs408", "english"],
      "properties": {
        "math": {"$ref": "#/$defs/subject"},
        "cs408": {"$ref": "#/$defs/subject"},
        "english": {"$ref": "#/$defs/subject"}
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["enabled", "counts", "pipeline", "items", "metrics"],
      "properties": {
        "enabled": {"type": "boolean"},
        "counts": {"type": "object"},
        "pipeline": {"type": "object"},
        "items": {"type": "array"},
        "metrics": {"type": "object"}
      }
    }
  }
}
