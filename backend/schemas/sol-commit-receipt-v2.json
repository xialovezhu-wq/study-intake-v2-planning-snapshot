{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/study-intake/sol-commit-receipt-v2.json",
  "title": "Sol commit receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "daily_sol_batch_sha256",
    "subject",
    "fencing_token",
    "writer",
    "writer_adapter",
    "sol_candidate_task_ids",
    "sol_handoff_envelope_sha256s",
    "execution_result_sha256",
    "sol_review_receipt_sha256",
    "pre_state_sha256",
    "post_state_sha256",
    "operations",
    "writer_process",
    "transaction_end",
    "recovery_position_sha256",
    "rollback_receipt_sha256",
    "status",
    "dispatcher_effect",
    "formal_write_count",
    "completed_at",
    "seal"
  ],
  "properties": {
    "schema_version": {"const": "sol_commit_receipt_v2"},
    "batch_id": {"$ref": "#/$defs/nonempty"},
    "daily_sol_batch_sha256": {"$ref": "#/$defs/sha256"},
    "subject": {"$ref": "#/$defs/subject"},
    "fencing_token": {"type": "integer", "minimum": 1},
    "writer": {"const": "sol"},
    "writer_adapter": {"$ref": "#/$defs/writerAdapter"},
    "sol_candidate_task_ids": {"$ref": "#/$defs/uniqueIds"},
    "sol_handoff_envelope_sha256s": {"$ref": "#/$defs/uniqueHashes"},
    "execution_result_sha256": {"$ref": "#/$defs/sha256"},
    "sol_review_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "pre_state_sha256": {"$ref": "#/$defs/sha256"},
    "post_state_sha256": {"$ref": "#/$defs/sha256"},
    "operations": {
      "type": "array",
      "items": {"type": "object", "minProperties": 1}
    },
    "writer_process": {"$ref": "#/$defs/writerProcess"},
    "transaction_end": {"$ref": "#/$defs/transactionEnd"},
    "recovery_position_sha256": {"$ref": "#/$defs/nullableSha256"},
    "rollback_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
    "status": {"enum": ["committed", "already_current", "failed", "rolled_back"]},
    "dispatcher_effect": {"$ref": "#/$defs/dispatcherEffect"},
    "formal_write_count": {"type": "integer", "minimum": 0},
    "completed_at": {"$ref": "#/$defs/nonempty"},
    "seal": {"$ref": "#/$defs/seal"}
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "failed"}}
      },
      "then": {
        "properties": {
          "recovery_position_sha256": {"$ref": "#/$defs/sha256"},
          "formal_write_count": {"const": 0}
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "rolled_back"}}
      },
      "then": {
        "properties": {
          "rollback_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "formal_write_count": {"const": 0}
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"enum": ["committed", "already_current"]}}
      },
      "then": {
        "properties": {
          "recovery_position_sha256": {"type": "null"},
          "rollback_receipt_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"enum": ["already_current", "failed", "rolled_back"]}}
      },
      "then": {"properties": {"formal_write_count": {"const": 0}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "nonempty": {"type": "string", "minLength": 1},
    "subject": {"enum": ["math", "cs408", "english"]},
    "writerAdapter": {
      "enum": [
        "math_nightly_writer_v1",
        "cs408_daily_intake_writer_v1",
        "english_daily_intake_writer_v1"
      ]
    },
    "uniqueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "uniqueHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "writerProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_run_id",
        "pid",
        "terminal_state",
        "exit_code",
        "stopped_at",
        "evidence_sha256"
      ],
      "properties": {
        "adapter_run_id": {"$ref": "#/$defs/nonempty"},
        "pid": {"type": "integer", "minimum": 1},
        "terminal_state": {"const": "stopped"},
        "exit_code": {"type": "integer", "minimum": 0},
        "stopped_at": {"$ref": "#/$defs/nonempty"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transactionEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "state", "ended_at", "evidence_sha256"],
      "properties": {
        "transaction_id": {"$ref": "#/$defs/nonempty"},
        "state": {"enum": ["committed", "already_current", "failed", "rolled_back"]},
        "ended_at": {"$ref": "#/$defs/nonempty"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dispatcherEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "subject",
        "paused_subjects",
        "drained_subjects",
        "other_subjects_unchanged"
      ],
      "properties": {
        "scope": {"const": "subject"},
        "subject": {"$ref": "#/$defs/subject"},
        "paused_subjects": {"const": []},
        "drained_subjects": {"const": []},
        "other_subjects_unchanged": {"const": true}
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "purpose", "hmac_sha256"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "purpose": {"const": "deterministic-writer-apply-receipt-v2"},
        "hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
